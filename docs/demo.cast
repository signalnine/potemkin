[803.3773, "o", " prints the identity),"]
[803.3979, "o", " type \"hello\\n\" \u2192"]
[803.4184, "o", " if"]
[803.4388, "o", " the supervisor bridges"]
[803.4593, "o", " pty\u2192"]
[803.4797, "o", "child"]
