[60.6711, "o", " overflow:"]
[60.6888, "o", " if the line"]
[60.7066, "o", " has"]
[60.7242, "o", " more than MAXTOK tokens \u2192"]
[60.742, "o", " error"]
[60.7596, "o", " \""]
[60.7772, "o", "too many words\"."]
[60.795, "o", " Fine.\r\r\n\r\r\n"]
[60.8127, "o", "Banner:\r\r\n\r\r\n```"]
[60.8305, "o", "\r\r\n"]
[60.8482, "o", "Pot"]
[60.8658, "o", "em"]
[60.8834, "o", "kinOS shell \u2014"]
[60.9012, "o", " v1"]
[60.9183, "o", "\r\r\nNo"]
[60.9361, "o", " user"]
[60.9537, "o", "land, just"]
[60.9714, "o", " you and the kernel."]
[60.9892, "o", " 'help' for"]
[61.007, "o", " commands, 'exit'"]
[61.0242, "o", " to quit.\r\r\n```\r\r\n\r\r\n"]
[61.0419, "o", "Keep it short.\r\r\n\r\r\nOne"]
[61.0597, "o", " more"]
[61.0773, "o", " feature"]
[61.0949, "o", " worth"]
[61.1125, "o", " adding: `"]
[61.1303, "o", "pwd`"]
[61.148, "o", " builtin ("]
[61.1658, "o", "cheap"]
[61.1833, "o", ","]
