[239.9377, "o", " forks the pwd child.\r\r\n5."]
[239.9558, "o", " pwd child"]
[239.9738, "o", ": getcwd \u2192"]
[239.9919, "o", " fputs"]
[240.0098, "o", " \u2192 exit"]
