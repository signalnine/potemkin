[71.6403, "o", "\r\r\n        }\r\r\n    }\r\r\n   "]
[71.6577, "o", " return n;\r\r\n}\r\r\n\r\r\nstatic int"]
[71.6749, "o", " read_line(void)\r\r\n{\r\r\n   "]
[71.6922, "o", " int len = 0;\r\r\n   "]
[71.7095, "o", " for (;;) {\r\r\n       "]
[71.7267, "o", " char c;\r\r\n        ssize_t r"]
[71.7439, "o", " = read(STDIN_FILENO, &c"]
