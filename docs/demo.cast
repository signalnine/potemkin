[59.5234, "o", "\r\r\n```\r\r\n\r\r\nNote: argv is"]
[59.5411, "o", " `char"]
[59.5588, "o", " (*)"]
[59.5764, "o", "[TOKLEN]"]
[59.5942, "o", "`; execv"]
[59.6119, "o", " wants char *const *"]
[59.6296, "o", " \u2014 since"]
[59.6473, "o", " TOKLEN is a"]
[59.6645, "o", " size"]
[59.6821, "o", ", the"]
[59.6992, "o", " types match"]
[59.7169, "o", " (each"]
[59.7346, "o", " element is a char array"]
[59.7523, "o", " \u2192"]
[59.7699, "o", " decays to char*)."]
[59.7876, "o", " The cast `(char *const *)argv"]
[59.8055, "o", "` works.\r\r\n\r\r\nAlso,"]
[59.8233, "o", " execv requires the array"]
[59.8404, "o", " to be"]
[59.8581, "o", " NULL-terminated"]
[59.8759, "o", "! My"]
[59.8937, "o", " tokens"]
[59.9114, "o", " aren't NULL-terminated"]
[59.9292, "o", " in the array"]
[59.9469, "o", " sense \u2014 the"]
[59.9646, "o", " array"]
[59.9822, "o", " has exactly"]
[60.0, "o", " argc elements,"]
[60.0171, "o", " no"]
[60.0347, "o", " sentinel. I need to"]
[60.0525, "o", " make"]
[60.0701, "o", " sure"]
