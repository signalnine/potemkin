[332.1847, "o", " + fork"]
[332.2032, "o", "/wait"]
[332.2215, "o", " pattern"]
[332.2399, "o", " doesn't"]
[332.2583, "o", " break"]
[332.2767, "o", " input delivery."]
[332.2951, "o", " So the"]
[332.3136, "o", " problem"]
[332.3319, "o", " is"]
[332.3503, "o", " in my shell, not"]
[332.3687, "o", " the harness.\r"]
[332.3688, "o", "\r\n\r\r\nSo"]
[332.3872, "o", ", in"]
[332.4057, "o", " my shell"]
[332.4242, "o", ", after the pipeline, the"]
[332.4427, "o", " next read"]
[332.4612, "o", " returned"]
[332.4795, "o", " EOF"]
[332.4978, "o", " (or"]
