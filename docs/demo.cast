[240.208, "o", " go to the same"]
[240.2262, "o", " fd"]
[240.2442, "o", " 1 (the"]
[240.2623, "o", " write"]
[240.2801, "o", " end of the"]
[240.2982, "o", " harness's capture pipe"]
[240.3162, "o", "). So the"]
[240.3343, "o", " harness's pipe"]
[240.3524, "o", " had \"/\\n\" but"]
[240.3705, "o", " it"]
[240.3884, "o", " wasn't"]
[240.4064, "o", " shown"]
[240.4243, "o", "??"]
[240.4422, "o", " Or the"]
[240.4603, "o", " pwd child never wrote it"]
[240.4783, "o", ".\r\r\n\r\r\n"]
[240.4964, "o", "Hmm"]
[240.5143, "o", ", wait,"]
[240.5323, "o", " did the pwd child"]
