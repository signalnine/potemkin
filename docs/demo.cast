[36.9894, "o", " from"]
[37.0068, "o", " fgets"]
[37.0243, "o", " (E"]
[37.0419, "o", "INTR)"]
[37.0595, "o", " \u2014 need to handle"]
[37.0771, "o", " EINTR"]
[37.0947, "o", " on"]
[37.1121, "o", " read and"]
[37.1298, "o", " reprint the prompt. And the child"]
