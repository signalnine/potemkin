[236.8944, "o", "ed child's"]
[236.9125, "o", " stdio"]
[236.9305, "o", "?\r\r\n\r\r\nAh"]
[236.9485, "o", ", wait. I think I"]
[236.9666, "o", " get it"]
[236.9847, "o", " now"]
[237.0026, "o", "!!!\r\r\n\r\r\nThe parent's stdio!"]
[237.0207, "o", " When"]
[237.0385, "o", " the"]
[237.0564, "o", " parent"]
[237.0743, "o", " (shell) forks"]
[237.0924, "o", ", the child"]
[237.1105, "o", " inherits the parent's stdio"]
[237.1285, "o", " buffer state \u2014 that's"]
[237.1467, "o", " fine"]
[237.1645, "o", ", it's"]
[237.1825, "o", " a copy. But"]
[237.2005, "o", " here's the"]
[237.2185, "o", " point: in"]
[237.2365, "o", " run_pipeline,"]
[237.2545, "o", " the parent itself"]
