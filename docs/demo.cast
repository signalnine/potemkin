[532.2764, "o", "\u2026 the parent process"]
[532.2959, "o", "'s"]
[532.3152, "o", " next read is at t=10"]
[532.3346, "o", "+D."]
[532.354, "o", " With D=0"]
[532.3733, "o", ":"]
[532.3926, "o", " the parent process"]
[532.4119, "o", " reaches read"]
[532.4312, "o", " at t\u224810"]
[532.4506, "o", ".0"]
[532.4698, "o", "x \u2014"]
[532.4892, "o", " microseconds after the child process's exit"]
[532.5086, "o", "!"]
[532.5278, "o", " And"]
[532.5469, "o", " yet"]
[532.5661, "o", " the harness still closed"]
[532.5855, "o", " stdin!\r\r\n\r\r\nSo"]
[532.6049, "o", " even with D=0"]
[532.6242, "o", " \u2014"]
[532.6434, "o", " the parent process"]
[532.6628, "o", " consumed"]
