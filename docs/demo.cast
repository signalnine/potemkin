[802.0257, "o", " break;\r\r\n        if (r =="]
[802.0463, "o", " 1"]
[802.0669, "o", " && len < 25"]
[802.0874, "o", "0)"]
[802.1079, "o", " line[len++] = c;\r\r\n       "]
[802.1284, "o", " if (r <= 0)"]
[802.149, "o", " break;\r\r\n    }\r\r\n    line"]
[802.1695, "o", "[len] = 0;\r\r\n   "]
[802.1901, "o", " fprintf(stdout, \"whocares:"]
[802.2107, "o", " stdin line"]
[802.2312, "o", ": '%s"]
[802.2517, "o", "'\\n\", line);\r\r\n    return"]
[802.2723, "o", " 0;\r\r\n}\r\r\n```"]
[802.2928, "o", "\r\r\n\r\r\n"]
[802.3132, "o", "If it's"]
[802.3337, "o", " really my"]
[802.3541, "o", " binary:"]
[802.3746, "o", " exe=/generated/bin"]
[802.3951, "o", "/whocares (or"]
