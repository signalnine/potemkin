[22.3686, "o", " die"]
[22.386, "o", "\r\r\n           "]
[22.4034, "o", " dup2(fd, "]
[22.4209, "o", "0);\r\r\n        } else {\r\r\n"]
[22.4385, "o", "            fd = open(path, O_WRONLY"]
[22.4561, "o", "|O_CREAT|O_TRUNC"]
[22.4737, "o", ", 06"]
[22.4911, "o", "44); if (fd<0"]
[22.5087, "o", ") die\r\r\n            dup2(fd,"]
[22.5263, "o", " 1);\r\r\n        }\r\r\n   "]
[22.5439, "o", " }\r\r\n   "]
