[60.5479, "o", "argc"]
[60.565, "o", "]=NULL. Then"]
[60.5827, "o", " execv"]
[60.6004, "o", "(prog, v).\r\r\n\r\r\n"]
[60.6182, "o", "Similarly"]
[60.6358, "o", ","]
