[348.0353, "o", " line 1"]
[348.0538, "o", ", then..."]
[348.0724, "o", " closed"]
[348.0907, "o", "?? Or"]
[348.1092, "o", " wrote line "]
[348.1278, "o", "1"]
[348.1462, "o", ", waited"]
[348.1647, "o", ","]
[348.1831, "o", " wrote line 2,"]
[348.2017, "o", " closed...\r\r\n\r\r\nIf the harness's"]
[348.2203, "o", " protocol is:"]
[348.2388, "o", " write"]
[348.2572, "o", " line N,"]
[348.2758, "o", " wait for output,"]
[348.2943, "o", " write"]
