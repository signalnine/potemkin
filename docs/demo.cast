[347.4592, "o", "50ms"]
[347.4778, "o", ":"]
[347.4963, "o", " fork"]
[347.5147, "o", ", exec"]
[347.5333, "o", " cat"]
[347.5517, "o", "/head,"]
[347.5704, "o", " file"]
