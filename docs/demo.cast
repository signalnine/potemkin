[530.7118, "o", "_line"]
[530.7309, "o", " for line 3 \u2192 EOF"]
[530.7503, "o", " in"]
[530.7695, "o", " all cases"]
[530.7888, "o", ", even with D=0.\r\r\n\r\r\n"]
[530.8082, "o", "So"]
[530.8275, "o", " in probe2,"]
