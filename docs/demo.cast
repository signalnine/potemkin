[346.7164, "o", " buffer is"]
[346.735, "o", "..."]
[346.7534, "o", " 64KB"]
[346.7719, "o", ". My input is"]
[346.7906, "o", " ~"]
[346.809, "o", "60 bytes."]
[346.8276, "o", " All"]
[346.8461, "o", " of it is delivered"]
[346.8648, "o", " up front. Then the"]
[346.8834, "o", " shell should read it"]
[346.902, "o", " all...\r\r\n\r\r\n"]
[346.9207, "o", "..."]
[346.9393, "o", "unless the shell's"]
[346.958, "o", " byte"]
[346.9764, "o", "-wise"]
[346.9949, "o", " reading"]
[347.0134, "o", " interacts"]
[347.0318, "o", " badly with"]
[347.0504, "o", " how the harness"]
[347.069, "o", " writes."]
[347.0876, "o", " If the harness writes"]
[347.1062, "o", " the whole stdin"]
[347.1248, "o", " in one"]
[347.1433, "o", " write()"]
[347.1619, "o", " syscall and"]
[347.1805, "o", " immediately closes the pipe"]
[347.1991, "o", ": the"]
[347.2176, "o", " pipe buffer has"]
[347.2362, "o", " all 60 bytes. The shell"]
[347.2549, "o", " reads byte by byte:"]
[347.2735, "o", " line 1"]
[347.2921, "o", " (2"]
[347.3107, "o", "7 bytes"]
[347.3292, "o", " +"]
[347.3477, "o", " \\n"]
[347.3662, "o", " = 28"]
[347.3849, "o", " reads), then"]
[347.4034, "o", " the pipeline"]
