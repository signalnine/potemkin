[239.0736, "o", " \u2014"]
[239.0914, "o", " no, waitpid"]
[239.1095, "o", " re"]
[239.1274, "o", "aps each one"]
[239.1455, "o", " individually"]
[239.1634, "o", "; it"]
[239.1814, "o", " loops"]
[239.1993, "o", " over"]
[239.2173, "o", " both pids.\r\r\n\r\r\n"]
[239.2354, "o", "Hmm,"]
[239.2534, "o", " so what"]
[239.2715, "o", " breaks the next child's output"]
[239.2895, "o", "??\r\r\n\r\r\n"]
[239.3075, "o", "Let me think about"]
[239.3256, "o", " test 3's"]
[239.3436, "o", " sequence from the"]
[239.3616, "o", " harness's"]
[239.3796, "o", " viewpoint:"]
[239.3976, "o", "\r\r\n1."]
[239.4156, "o", " Shell's"]
