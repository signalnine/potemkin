[347.6447, "o", " remaining"]
[347.6632, "o", " "]
[347.6817, "o", "13 bytes are"]
[347.7003, "o", " still in the"]
[347.7189, "o", " pipe buffer \u2192 \"pwd\\n"]
[347.719, "o", "\" and"]
[347.7376, "o", " \"exit\\n\" are readable \u2192"]
[347.7562, "o", " no"]
[347.7746, "o", " early EOF!\r\r\n\r\r\n"]
[347.7747, "o", "But the"]
[347.7933, "o", " evidence says"]
[347.8119, "o", " EOF"]
[347.8304, "o", " came right after"]
[347.849, "o", " line 1. So the"]
[347.8676, "o", " bytes \"pwd\\n"]
[347.8862, "o", "exit\\n\" were not in the pipe"]
[347.9049, "o", " when the shell"]
[347.9235, "o", " tried to read them"]
[347.9421, "o", ", and the"]
