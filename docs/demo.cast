[217.1065, "o", "```\r\r\n\r\r\n"]
[217.1244, "o", "From memory,"]
[217.1423, "o", " musl's getcwd"]
[217.1603, "o", ":\r\r\n1. Gets"]
[217.1783, "o", " the"]
