[27.377, "o", " = 0;\r\r\n    return n"]
[27.3946, "o", ";\r\r\n}\r\r\n```\r\r\n\r\r\nHmm,"]
[27.4123, "o", " the `>file` handling"]
[27.4299, "o", " with no space is getting"]
[27.4475, "o", " tangled."]
[27.465, "o", " Let me simplify:"]
[27.4826, "o", " treat `>` and"]
[27.5002, "o", " `<` as standalone tokens"]
[27.5177, "o", " only"]
[27.5351, "o", " if they"]
[27.5526, "o", " are the"]
[27.5701, "o", " whole word;"]
[27.5876, "o", " also support"]
[27.6045, "o", " the"]
[27.6219, "o", " glued `>file`"]
[27.6395, "o", " form. Let me write"]
[27.6571, "o", " it cleanly:\r\r\n\r\r\n"]
[27.6741, "o", "For each word:\r\r\n-"]
[27.691, "o", " skip whitespace\r\r\n-"]
[27.7087, "o", " if"]
[27.7262, "o", " s[i]=='>' or"]
[27.7437, "o", " '<': read the"]
[27.7612, "o", " operator"]
[27.7786, "o", " ("]
[27.796, "o", "including"]
[27.8134, "o", " possible `>>`"]
[27.831, "o", ");"]
[27.8484, "o", " then read the rest of the word ("]
[27.866, "o", "up to"]
[27.8835, "o", " whitespace) as the target."]
[27.9011, "o", " Produce"]
[27.9186, "o", " two tokens: \""]
[27.9361, "o", "op\""]
[27.9536, "o", " and \"target"]
[27.9711, "o", "\" (if target is non-empty)."]
[27.9888, "o", " If op is"]
[28.0063, "o", " \">\" and target"]
[28.0232, "o", " is empty"]
[28.0407, "o", " -> error"]
[28.0577, "o", " \""]
[28.0751, "o", "missing"]
[28.0925, "o", " redirect target"]
[28.11, "o", "\""]
[28.1274, "o", " \u2014"]
[28.1448, "o", " but I can"]
[28.1624, "o", " defer"]
[28.1791, "o", " the error to the command"]
[28.1967, "o", " parser"]
[28.2141, "o", ".\r\r\n-"]
[28.231, "o", " otherwise:"]
[28.2487, "o", " read the word with"]
[28.2663, "o", " quote handling.\r\r\n\r\r\n"]
[28.2838, "o", "Then"]
[28.3012, "o", " in the command"]
[28.3187, "o", " parser:"]
[28.3362, "o", " tokens[0"]
[28.3537, "o", ".."]
[28.3711, "o", "]."]
[28.3886, "o", " Scan"]
[28.406, "o", " from the end"]
[28.4235, "o", "?"]
[28.4409, "o", " Redirects"]
[28.4584, "o", ":"]
[28.4758, "o", " look for the tokens"]
[28.4934, "o", " \">\""]
[28.5108, "o", " or"]
[28.5282, "o", " \""]
[28.5456, "o", "<<\" or"]
[28.5631, "o", " \"<\"."]
[28.5801, "o", " Take the"]
[28.5976, "o", " last one"]
[28.6151, "o", " found."]
[28.6326, "o", " Everything"]
[28.65, "o", " before it is the command,"]
[28.6675, "o", " the token"]
[28.685, "o", " after it is the"]
[28.7026, "o", " file.\r\r\n\r\r\n"]
[28.7201, "o", "Parser"]
[28.7375, "o", " plan:\r\r\n```c\r\r\nint n"]
[28.7551, "o", " = tokenize"]
[28.7725, "o", "(line, toks,"]
[28.7901, "o", " ...);\r\r\n"]
