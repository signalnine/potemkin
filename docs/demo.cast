[816.9654, "o", "6104341"]
[816.986, "o", "8e0f0"]
[817.0065, "o", "c4"]
[817.027, "o", "e4"]
[817.0475, "o", "b6ba3"]
[817.068, "o", "93c8517"]
[817.0886, "o", "96f6/bin`\r\r\n\r\r\nThese"]
[817.1093, "o", " are"]
[817.1297, "o", " my"]
[817.1501, "o", " binaries"]
[817.1705, "o", "! The hash of"]
[817.191, "o", " 8dfbd4... is"]
[817.2117, "o", " my"]
[817.232, "o", " `cat` ("]
[817.2526, "o", "from the"]
[817.2732, "o", " compile output:"]
[817.2937, "o", " /generated/bin"]
[817.3142, "o", "/cat ->"]
