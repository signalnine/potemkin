[323.5507, "o", " a child"]
[323.5692, "o", ","]
[323.5875, "o", " wait"]
[323.6058, "o", " ("]
[323.6241, "o", "simulate"]
[323.6424, "o", " the pipeline"]
[323.6608, "o", "'s"]
[323.6791, "o", " duration"]
[323.6973, "o", " ~5"]
[323.7157, "o", "0ms), then"]
[323.7342, "o", " keep reading"]
[323.7526, "o", "."]
[323.7709, "o", " Print"]
[323.7892, "o", " each line"]
[323.8076, "o", " it"]
[323.8259, "o", " got"]
[323.8442, "o", ", and"]
[323.8626, "o", " log the EOF."]
[323.881, "o", " If the"]
[323.8995, "o", " program also gets"]
[323.9179, "o", " an early EOF after the"]
[323.9365, "o", " \"pipeline\" line"]
[323.955, "o", " \u2192 the harness is the"]
[323.9734, "o", " cause. If it gets"]
[323.9919, "o", " all"]
[324.0102, "o", " the lines \u2192 my shell is"]
[324.0287, "o", " doing something wrong.\r\r\n\r\r\nLet me write"]
[324.0472, "o", " that"]
[324.0655, "o", " probe:\r\r\n\r\r\n```c\r\r\n#include "]
[324.084, "o", "<stdio.h>\r\r\n#include "]
[324.1025, "o", "<stdlib.h>\r\r\n#include "]
[324.1211, "o", "<string.h>\r\r\n#include <unistd.h"]
[324.1397, "o", ">\r\r\n#include <sys"]
[324.1581, "o", "/wait.h>\r\r\n#include "]
[324.1766, "o", "<time.h>\r\r\n\r\r\nstatic int"]
[324.1951, "o", " read_line"]
[324.2135, "o", "(char *buf"]
[324.2319, "o", ", int size) {\r\r\n"]
[324.2506, "o", "    int len = 0;\r\r\n"]
[324.2691, "o", "    for (;;) {\r\r\n        char c"]
[324.2877, "o", ";\r\r\n        ssize_t r = read"]
[324.3061, "o", "(0, &c, 1"]
[324.3246, "o", ");\r\r\n        if (r == "]
[324.3431, "o", "1) {\r\r\n            if (c"]
[324.3616, "o", " == '\\n')"]
[324.38, "o", " { buf[len] = 0;"]
[324.3985, "o", " return 0; }\r\r\n           "]
[324.417, "o", " if (len"]
[324.4355, "o", " + 1 < size) buf[len"]
[324.454, "o", "++] = c;\r\r\n        } else"]
[324.4727, "o", " if (r == 0) {"]
[324.4912, "o", "\r\r\n            buf[len] = 0"]
[324.5097, "o", ";\r\r\n            return"]
[324.5282, "o", " 1;"]
[324.5466, "o", "\r\r\n        } else {\r\r\n            if"]
[324.5651, "o", " (errno == EINTR)"]
[324.5836, "o", " continue;\r\r\n            return 1;"]
[324.6021, "o", "\r\r\n        }\r\r\n    }\r\r\n"]
[324.6206, "o", "}"]
[324.6389, "o", "\r\r\n"]
[324.6572, "o", "```\r\r\n\r\r\nWait,"]
[324.6756, "o", " I need errno \u2014"]
[324.6941, "o", " include"]
[324.7124, "o", " it."]
[324.7309, "o", " And the main loop:\r\r\n\r\r\n```c"]
[324.7495, "o", "\r\r\nint main(void) {\r\r\n   "]
[324.768, "o", " char buf["]
[324.7865, "o", "512];\r\r\n   "]
[324.805, "o", " int"]
[324.8233, "o", " lineno = 0;\r\r\n    for"]
[324.8418, "o", " (;;) {\r\r\n       "]
[324.8603, "o", " fprintf(stderr, \""]
[324.8787, "o", "probe:"]
[324.8971, "o", " read line"]
[324.9155, "o", " %d\\n\","]
[324.934, "o", " ++lineno);\r\r\n        if (read"]
[324.9525, "o", "_line(buf"]
[324.9709, "o", ","]
[324.9892, "o", " sizeof buf)) {\r\r\n            fprintf(stderr"]
[325.0078, "o", ", \"probe: EOF"]
[325.0262, "o", " at line %d\\n\","]
[325.0447, "o", " lineno);\r\r\n           "]
[325.0632, "o", " break;\r\r\n        }\r\r\n        fprintf"]
[325.0817, "o", "(stderr, \"probe: got: %"]
[325.1003, "o", "s\\n\", buf);\r\r\n        if"]
[325.1189, "o", " ("]
[325.1373, "o", "strstr(buf, \"|\")) {\r\r\n           "]
[325.1559, "o", " /* simulate a pipeline:"]
[325.1744, "o", " fork a child, sleep 10"]
[325.1929, "o", "0ms, wait */\r\r\n            pid"]
[325.2114, "o", "_t"]
[325.2298, "o", " p = fork();\r\r\n            if ("]
[325.2483, "o", "p == 0) {"]
[325.2668, "o", " usleep(100"]
[325.2853, "o", "000); _exit("]
[325.3037, "o", "0); }\r\r\n           "]
[325.3223, "o", " int"]
[325.3406, "o", " st; waitpid"]
[325.359, "o", "(p, &st, 0);"]
[325.3775, "o", "\r\r\n            fprintf(stderr, \"probe:"]
[325.3961, "o", " pipeline done\\n\");\r\r\n        }\r\r\n"]
[325.4146, "o", "        if"]
[325.433, "o", " (!"]
[325.4513, "o", "strcmp(buf, \"exit\")) break;"]
[325.4698, "o", "\r\r\n    }\r\r\n    fprintf(stderr,"]
[325.4883, "o", " \"probe: done\\n\");\r\r\n   "]
[325.5068, "o", " return 0;\r\r\n}\r\r\n```"]
[325.5253, "o", "\r\r\n\r\r\nFeed"]
[325.5438, "o", " it:"]
[325.5622, "o", "\r\r\n```\r\r\nline"]
[325.5806, "o", " one\r\r\ncat"]
[325.599, "o", " a |"]
[325.6175, "o", " head\r\r\nline two\r\r\n"]
[325.6359, "o", "exit\r\r\n```\r\r\n\r\r\nIf the probe sees"]
[325.6545, "o", " EOF at \"line two\" \u2192 the"]
[325.6729, "o", " harness is"]
[325.6913, "o", " the cause (it's"]
[325.71, "o", " stopping"]
[325.7283, "o", " input after the pipeline"]
[325.7467, "o", "-like activity"]
[325.7652, "o", "). If"]
[325.7837, "o", " it sees all"]
[325.8021, "o", " the lines \u2192 my"]
[325.8206, "o", " shell"]
[325.8389, "o", " has a bug.\r\r\n\r\r\nLet me"]
[325.8573, "o", " build and run"]
[325.8757, "o", " this probe.\r\r\n"]
[325.8758, "o", "\u001b[0m\r\r\n\r\r\nThe"]
[325.8943, "o", " trace reveals"]
[325.9127, "o", " something important: the"]
[325.9127, "o", " `pwd` child"]
[325.9313, "o", " process **never"]
[325.9497, "o", " ran at all** \u2014"]
[325.9682, "o", " after the pipeline, the shell's"]
[325.9867, "o", " next `read()`"]
[326.0053, "o", " on stdin hit EOF, and"]
[326.0238, "o", " it exited cleanly."]
