[79.4198, "o", "2 = 16"]
[79.437, "o", "KB on"]
[79.4542, "o", " the"]
[79.4713, "o", " stack \u2014 fine"]
[79.4886, "o", ".\r\r\n\r\r\nNow, the"]
[79.5059, "o", " banner"]
[79.523, "o", " only in tty"]
[79.5402, "o", " mode; if"]
[79.5574, "o", " piped,"]
[79.5746, "o", " no prompt"]
[79.5919, "o", " (good for"]
[79.6091, "o", " automation).\r\r\n\r\r\nCompile"]
[79.6264, "o", " as `sh`, then"]
[79.6437, "o", " spawn with"]
[79.6611, "o", " mode=t"]
[79.6784, "o", "ty.\r\r\n\r\r\n"]
[79.6956, "o", "Also"]
[79.7127, "o", ", should I mention"]
[79.73, "o", " how to"]
[79.7472, "o", " get out"]
[79.7645, "o", " / how to"]
[79.7817, "o", " manage it? In"]
[79.799, "o", " tty mode, I can"]
[79.8163, "o", "'t"]
[79.8334, "o", " type"]
[79.8505, "o", " on the"]
[79.8678, "o", " user's"]
[79.8851, "o", " behalf"]
[79.9022, "o", "; the user"]
[79.9194, "o", " types directly"]
[79.9367, "o", " in the console"]
[79.9539, "o", ". I"]
[79.9711, "o", "'ll say:"]
[79.9884, "o", " it's"]
[80.0056, "o", " running"]
[80.0228, "o", ", type"]
[80.04, "o", " commands;"]
[80.0573, "o", " 'exit' to quit;"]
[80.0746, "o", " I can send"]
[80.0919, "o", " signals via"]
[80.1091, "o", " wait if needed.\r\r\n\r\r\nLet me"]
[80.1264, "o", " also double-check"]
[80.1437, "o", " that spawn"]
[80.1609, "o", "'s tty mode doesn't"]
[80.1782, "o", " take a timeout \u2014"]
[80.1956, "o", " right,"]
[80.2129, "o", " tty"]
[80.2301, "o", " returns"]
[80.2473, "o", " the pid immediately"]
[80.2645, "o", "? \""]
[80.2817, "o", "tty gives the"]
[80.299, "o", " console to the program until it"]
[80.3162, "o", " exits\" \u2014"]
[80.3335, "o", " probably returns immediately"]
[80.3508, "o", " with the pid,"]
[80.3681, "o", " similar to"]
[80.3853, "o", " background."]
[80.4026, "o", " Either way"]
[80.4198, "o", ", fine.\r\r\n\r\r\nLet me write the"]
[80.4372, "o", " source"]
[80.4543, "o", " file to"]
[80.4715, "o", " /src"]
[80.4887, "o", "/sh.c"]
[80.506, "o", " too"]
[80.5231, "o", ", for consistency with the"]
[80.5404, "o", " ls pattern. Actually, I"]
[80.5577, "o", " decided"]
[80.5749, "o", " to skip"]
[80.5921, "o", " it"]
[80.6092, "o", " to save"]
[80.6265, "o", " tokens\u2026"]
[80.6438, "o", " but the"]
[80.661, "o", " first"]
[80.6782, "o", " turn wrote"]
[80.6955, "o", " to /src."]
[80.7127, "o", " /"]
[80.7298, "o", "store"]
[80.7469, "o", " keeps the source"]
[80.7643, "o", " with the hash anyway"]
[80.7816, "o", "."]
[80.7988, "o", " The"]
[80.816, "o", " description says"]
[80.8333, "o", " \"/store"]
[80.8505, "o", " holds all"]
[80.8677, "o", " binaries with their source\". So"]
[80.885, "o", " the source is"]
[80.9023, "o", " preserved. Skip"]
[80.9195, "o", " the /"]
[80.9367, "o", "src write. Hmm"]
[80.954, "o", " \u2014 but /src"]
[80.9712, "o", " is"]
[80.9883, "o", " the"]
[81.0054, "o", " natural place I"]
[81.0226, "o", " created"]
[81.0398, "o", "."]
[81.0568, "o", " Well,"]
[81.0741, "o", " skip"]
[81.0912, "o", " it;"]
[81.1084, "o", " /store"]
[81.1256, "o", " has it.\r\r\n\r\r\nNow"]
[81.1429, "o", " compile"]
[81.16, "o", ","]
[81.1771, "o", " and if"]
[81.1943, "o", " it"]
[81.2114, "o", " succeeds,"]
[81.2287, "o", " spawn in tty.\r\r\n\r\r\nLet"]
[81.246, "o", " me also double"]
[81.2632, "o", "-check the"]
[81.2805, "o", " `"]
[81.2976, "o", ">>`"]
[81.3148, "o", " tokenize:"]
[81.332, "o", " `s[i"]
[81.3492, "o", "]=='>'` then `"]
[81.3665, "o", "if (s[i"]
[81.3839, "o", "]=='>')` \u2014 I"]
[81.4012, "o", " wrote `tok[i][1"]
[81.4185, "o", "]=="]
[81.4356, "o", "'> '`. Let me write"]
[81.4529, "o", " it cleanly."]
[81.4702, "o", "\r\r\n\u001b[0m\r\r\n\r\r\n"]
[89.1526, "o", "\r\r\n"]
[89.1528, "o", "\u001b[2m  compile sh.c\r\r\n\u001b[0m"]
[89.2282, "o", "\u001b[2m    exit=0 sha256:81b553556ab8f21af6a6b2fc5427d5aad66ebd158fa28724c758b58a1ad2a959\r\r\n\u001b[0m"]
[93.7665, "o", "\u001b[2mThe build"]
[93.7837, "o", " succeeded."]
[93.8009, "o", " Before"]
[93.818, "o", " handing"]
[93.8352, "o", " the"]
[93.8523, "o", " terminal to the user, let's do"]
[93.8697, "o", " a simple smoke test"]
[93.8869, "o", " in capture mode to"]
[93.9042, "o", " confirm"]
[93.9214, "o", " it works ("]
[93.9387, "o", "running commands"]
[93.956, "o", " via piped"]
[93.9733, "o", " stdin). This is a"]
[93.9907, "o", " good"]
[94.008, "o", " verification:"]
[94.0255, "o", " pass \""]
[94.0428, "o", "help\\nls /data\\n"]
[94.0602, "o", "exit\\n\""]
[94.0776, "o", " via stdin.\r\r\n\u001b[0m\r\r\n\r\r\n"]
[94.0949, "o", "Built."]
[94.1123, "o", " Quick smoke test before"]
[94.1296, "o", " handing"]
[94.1468, "o", " you the console:\r\r\n\r\r\n"]
[94.4764, "o", "\r\r\n\u001b[2m  spawn /generated/bin/sh sh\r\r\n\u001b[0m"]
[94.5538, "o", "\u001b[2m    exit=0\r\r\n\u001b[0m"]
[94.708, "o", "\u001b[2mInteresting \u2014 the smoke"]
[94.7253, "o", " test revealed"]
[94.7425, "o", " problems:\r\r\n\r\r\n1. `help`"]
[94.7598, "o", " printed nothing"]
[94.7771, "o", "! The output"]
[94.7944, "o", " starts with \"PotemkinOS shell"]
[94.8117, "o", "\" ("]
[94.8289, "o", "banner), then"]
[94.8462, "o", " jumps to"]
[94.8635, "o", " ls output. The help"]
[94.8807, "o", " output"]
[94.8978, "o", " is missing."]
[94.9151, "o", " Why?"]
[94.9324, "o", " Because in"]
[94.9496, "o", " non-tty mode"]
[94.9669, "o", "... wait, the help"]
[94.9841, "o", " builtin runs in a fork"]
[95.0014, "o", "ed child"]
[95.0187, "o", " process, and"]
[95.036, "o", " does `print_help"]
[95.0534, "o", "(); _exit(0"]
[95.0707, "o", ")`."]
[95.088, "o", " Hmm, the output should"]
[95.1052, "o", " show up"]
[95.1225, "o", "."]
[95.1396, "o", " Could it be"]
[95.1569, "o", "... stdout buffering?"]
[95.1742, "o", " In"]
[95.1913, "o", " the child process,"]
[95.2085, "o", " print_help's"]
[95.2258, "o", " output goes"]
[95.243, "o", " into"]
[95.2602, "o", " stdio's"]
[95.2774, "o", " buffer, and"]
[95.2947, "o", " `_exit(0)` without"]
[95.312, "o", " fflush"]
[95.3291, "o", " discards the buffer!"]
[95.3464, "o", " That's the bug"]
[95.3637, "o", ": _exit"]
[95.381, "o", " doesn't"]
[95.3983, "o", " flush stdio buffers."]
[95.4156, "o", " Same for"]
[95.4328, "o", " pwd"]
[95.45, "o", " (puts) and echo ("]
[95.4674, "o", "putchar"]
[95.4846, "o", "/fputs).\r\r\n\r\r\n"]
[95.5019, "o", "Wait, but"]
[95.5192, "o", " the ls output"]
[95.5366, "o", " showed up \u2014"]
[95.5539, "o", " ls is"]
[95.5711, "o", " an exec"]
[95.5885, "o", "'d program, and the buffer"]
[95.6058, "o", " gets flushed"]
[95.623, "o", " on"]
[95.6402, "o", " exec."]
[95.6575, "o", " But"]
[95.6747, "o", " builtins"]
[95.6919, "o", " that"]
[95.7091, "o", " _exit"]
[95.7264, "o", " lose"]
[95.7435, "o", " their"]
[95.7607, "o", " buffered output.\r\r\n\r\r\n"]
[95.778, "o", "2. `"]
[95.7952, "o", "echo hello from sh > /state/sh"]
[95.8126, "o", "-test.txt` \u2014 same"]
[95.8299, "o", " buffering problem"]
[95.8472, "o", ": the child"]
[95.8644, "o", " process opens the file"]
[95.8817, "o", ", dup2"]
[95.899, "o", "s"]
[95.9162, "o", " fd"]
[95.9333, "o", " 1,"]
[95.9506, "o", " fputs"]
[95.9677, "o", " to"]
[95.9849, "o", " stdout (buffered"]
[96.0022, "o", "), _exit"]
[96.0195, "o", " \u2192"]
[96.0367, "o", " nothing"]
[96.0538, "o", " gets written"]
[96.0711, "o", "!\r\r\n\r\r\n3. `"]
[96.0885, "o", "cat`"]
[96.1058, "o", " doesn't exist \u2014"]
[96.1232, "o", " as expected"]
[96.1405, "o", ", there's no cat yet. The"]
[96.1579, "o", " user is"]
[96.1752, "o", " going to"]
[96.1925, "o", " want cat, so I should build cat"]
[96.2098, "o", " too."]
[96.2271, "o", " In fact,"]
[96.2444, "o", " for"]
[96.2615, "o", " shell usability, cat is a"]
[96.2788, "o", " basic command. Let me build cat"]
[96.2961, "o", " (and"]
[96.3134, "o", " head?"]
[96.3307, "o", " I"]
[96.3479, "o", " used head in the"]
[96.3652, "o", " test but"]
[96.3825, "o", " it doesn't exist \u2014"]
[96.3998, "o", " the shell"]
[96.4171, "o", " should have"]
[96.4343, "o", " said \""]
[96.4516, "o", "head: command not found\" \u2014"]
[96.4689, "o", " but wait,"]
[96.4862, "o", " the"]
[96.5033, "o", " output"]
[96.5205, "o", " has nothing"]
[96.5378, "o", " between the"]
[96.5552, "o", " cat error and"]
[96.5726, "o", " pwd."]
[96.5899, "o", " `cat"]
[96.6072, "o", " file 2>&1 | head -"]
[96.6246, "o", "1"]
[96.6417, "o", "` \u2014"]
[96.659, "o", " my shell"]
[96.6762, "o", " doesn't support pipes! So the"]
[96.6935, "o", " whole line"]
[96.7107, "o", " was"]
[96.7279, "o", " treated as the command"]
[96.7452, "o", " `cat` with"]
[96.7625, "o", " arguments"]
[96.7796, "o", " `/state/sh-test.txt"]
[96.797, "o", " 2>&1 | head -1"]
[96.8143, "o", "`."]
[96.8315, "o", " So it"]
[96.8488, "o", " became \"sh: cat"]
[96.8661, "o", ": command not found\""]
[96.8834, "o", " (cat"]
[96.9006, "o", " isn't found), and"]
[96.9179, "o", " `2>&1"]
[96.9352, "o", "`, `|`, `head"]
[96.9525, "o", "`, `-1` were just arguments."]
[96.9699, "o", " OK.\r\r\n\r\r\nSo the"]
[96.9873, "o", " fixes"]
[97.0045, "o", ":\r\r\n1."]
[97.0218, "o", " In the"]
[97.039, "o", " child process, flush"]
[97.0563, "o", " stdio before _exit"]
[97.0737, "o", " (or"]
[97.091, "o", " use"]
[97.1081, "o", " write"]
[97.1253, "o", "() directly, or"]
[97.1425, "o", " call"]
[97.1598, "o", " exit"]
[97.1769, "o", "() instead of _exit"]
[97.1943, "o", "() \u2014 exit() flushes"]
[97.2116, "o", " buffers"]
[97.2288, "o", " and"]
[97.2459, "o", " runs at"]
[97.2633, "o", "exit handlers;"]
[97.2806, "o", " in a child process"]
[97.2979, "o", " after fork, exit() is"]
[97.3152, "o", " safe and"]
[97.3325, "o", " correct)."]
[97.3498, "o", " Simplest:"]
[97.3671, "o", " replace"]
[97.3842, "o", " the builtin"]
[97.4014, "o", " child's _exit"]
[97.4187, "o", "(n) with exit(n)?"]
[97.436, "o", " Caution: exit()"]
[97.4535, "o", " in the forked"]
[97.4708, "o", " child"]
[97.4879, "o", " is fine \u2014 it"]
[97.5052, "o", " flushes stdio"]
[97.5225, "o", ". But the"]
[97.5398, "o", " redirect"]
[97.557, "o", ": we"]
[97.5742, "o", " dup2"]
[97.5915, "o", "'d the"]
[97.6088, "o", " fd,"]
[97.6261, "o", " so the buffer"]
[97.6433, "o", " gets flushed to the correct"]
[97.6606, "o", " fd. Yes, use"]
[97.6779, "o", " exit() in the"]
[97.6952, "o", " child. Actually,"]
[97.7125, "o", " for the \""]
[97.7298, "o", "command not found\" and"]
[97.7471, "o", " exec"]
[97.7643, "o", "-failure"]
[97.7815, "o", " paths, _exit"]
[97.7989, "o", " is fine"]
[97.8162, "o", " ("]
[97.8333, "o", "the error goes to"]
[97.8506, "o", " unbuffered stderr)."]
[97.8679, "o", " For the builtin"]
[97.8852, "o", " output paths, use exit"]
[97.9026, "o", "() to flush.\r\r\n\r\r\nActually,"]
[97.92, "o", " cleaner:"]
[97.9373, "o", " fflush(stdout) before"]
[97.9546, "o", " _exit"]
[97.9718, "o", ". Either works."]
[97.9891, "o", " Let me use"]
[98.0064, "o", " exit() in the"]
[98.0238, "o", " success path of"]
[98.041, "o", " echo/help"]
[98.0584, "o", "/pwd.\r\r\n\r\r\n"]
[98.0757, "o", "Hmm wait,"]
[98.093, "o", " one"]
[98.1101, "o", " subtle point:"]
[98.1275, "o", " `exit()` in the"]
[98.1448, "o", " child"]
[98.1619, "o", " \u2014 std"]
[98.1793, "o", "io buffers"]
[98.1965, "o", " get flushed"]
[98.2138, "o", ", no problem. OK."]
[98.2311, "o", "\r\r\n\r\r\n2."]
[98.2484, "o", " Add"]
[98.2656, "o", " pipe support"]
[98.2828, "o", "? The"]
[98.3002, "o", " user is missing"]
[98.3175, "o", " a shell; pipes are"]
[98.3348, "o", " core."]
[98.3521, "o", " That's a bigger"]
[98.3694, "o", " change:"]
[98.3867, "o", " need to parse"]
[98.4041, "o", " `|`, and"]
[98.4215, "o", " for a"]
[98.4388, "o", " chain of commands,"]
[98.456, "o", " connect"]
[98.4732, "o", " stdout"]
[98.4903, "o", "\u2192stdin with a"]
[98.5077, "o", " pipe,"]
[98.525, "o", " fork all the"]
[98.5422, "o", " children, and"]
[98.5595, "o", " wait"]
[98.5767, "o", " for"]
[98.5938, "o", " all of them."]
[98.6111, "o", " Doable. Let me implement it"]
[98.6285, "o", " \u2014 the shell is"]
[98.6458, "o", " far"]
[98.6629, "o", " more"]
[98.6801, "o", " useful with"]
[98.6974, "o", " pipes.\r\r\n\r\r\n"]
[98.7147, "o", "3."]
[98.7319, "o", " Build"]
[98.749, "o", " `cat`"]
[98.7663, "o", " so the"]
[98.7836, "o", " user"]
[98.8007, "o", " has a basic"]
[98.818, "o", " way to read"]
[98.8353, "o", " files. Also `head"]
[98.8526, "o", "`?"]
[98.8699, "o", " Let"]
[98.887, "o", "'s"]
[98.9041, "o", " be"]
[98.9213, "o", " realistic: build cat and"]
[98.9386, "o", " head. And"]
[98.9559, "o", " `"]
[98.973, "o", "grep`?"]
[98.9905, "o", " I'm"]
[99.0078, "o", " getting"]
[99.025, "o", " carried away."]
[99.0423, "o", " cat + head are"]
[99.0597, "o", " cheap"]
[99.0768, "o", " and"]
[99.094, "o", " high-value."]
[99.1113, "o", " Actually"]
[99.1285, "o", ", for a"]
[99.1459, "o", " \"shell\""]
[99.1632, "o", " experience, what"]
[99.1805, "o", " the user"]
[99.1978, "o", " will immediately want is: cat"]
[99.1978, "o", ","]
[99.2152, "o", " head,"]
[99.2325, "o", " grep,"]
[99.2499, "o", " wc"]
[99.2671, "o", "... but"]
[99.2844, "o", " I shouldn't build the whole"]
[99.3018, "o", " user"]
[99.3191, "o", "land"]
[99.3363, "o", " right now"]
[99.3536, "o", "; the"]
[99.371, "o", " request"]
[99.3882, "o", " was a shell. Let me build cat"]
[99.4056, "o", " and head ("]
[99.4229, "o", "both"]
[99.4401, "o", " small),"]
[99.4575, "o", " mention that"]
[99.4749, "o", " more"]
[99.4921, "o", " commands can be added"]
[99.5094, "o", " on demand, and fix the"]
[99.5268, "o", " shell.\r\r\n\r\r\nLet me"]
[99.5443, "o", " implement"]
[99.5616, "o", " pipes in"]
[99.579, "o", " sh:\r\r\n\r\r\nParsing"]
[99.5964, "o", ": after"]
[99.6137, "o", " tokenize, split the"]
[99.6311, "o", " token"]
[99.6484, "o", " stream"]
[99.6656, "o", " by `|`"]
[99.6829, "o", " into"]
[99.7001, "o", " a series of segments. Each segment is"]
[99.7175, "o", " a command + optional trailing"]
[99.7349, "o", " redirect.\r\r\n\r\r\n"]
[99.7523, "o", "Implementation:"]
[99.7696, "o", "\r\r\n"]
[99.7868, "o", "```c\r\r\n"]
[99.8042, "o", "/*"]
[99.8214, "o", " split"]
[99.8386, "o", " into"]
[99.8559, "o", " pipelines */\r\r\n"]
[99.8732, "o", "typedef struct {"]
[99.8905, "o", " int"]
[99.9077, "o", " start, end;"]
[99.925, "o", " } seg"]
[99.9423, "o", "_t;"]
[99.9597, "o", " /*"]
[99.9769, "o", " tok"]
[99.9942, "o", " indices [start, end"]
[100.0115, "o", ") */\r\r\n"]
[100.0289, "o", "```"]
[100.0461, "o", "\r\r\n\r\r\nScan"]
[100.0635, "o", " tokens,"]
[100.0808, "o", " and whenever"]
[100.0981, "o", " tok[i"]
[100.1154, "o", "]==\"|\","]
[100.1329, "o", " cut"]
[100.1502, "o", " there. Each segment"]
[100.1677, "o", ":"]
[100.185, "o", " command tokens from"]
[100.2023, "o", " prev_start to"]
[100.2197, "o", " i, and the"]
[100.237, "o", " redirect"]
[100.2542, "o", " scan is within the segment ("]
[100.2717, "o", "as before"]
[100.289, "o", ", scan from"]
[100.3064, "o", " i-1"]
[100.3237, "o", " down to"]
[100.341, "o", " start+1"]
[100.3584, "o", " for"]
[100.3756, "o", " >"]
[100.3928, "o", ", >>,"]
[100.4102, "o", " <).\r\r\n\r\r\n"]
[100.4275, "o", "Then"]
[100.4448, "o", " execute"]
[100.462, "o", " the pipeline:\r\r\n```c\r\r\n"]
[100.4794, "o", "static int"]
[100.4967, "o", " run_pipeline"]
[100.514, "o", "(char"]
[100.5312, "o", " (*"]
[100.5484, "o", "argv)[TOKLEN], int"]
[100.5659, "o", " *"]
[100.583, "o", "starts, int *ends,"]
[100.6005, "o", " int n"]
[100.6178, "o", "segs, struct"]
[100.6352, "o", " redir *"]
[100.6526, "o", "reds)\r\r\n{\r\r\n   "]
[100.67, "o", " int prev ="]
[100.6875, "o", " -1; /*"]
[100.7048, "o", " fd"]
[100.722, "o", " feeding the"]
[100.7394, "o", " first"]
[100.7565, "o", " command's stdin"]
[100.7739, "o", ", or"]
[100.7912, "o", " -1 */\r\r\n    int"]
[100.8085, "o", " pids"]
[100.8259, "o", "[MAXTOK]; int"]
[100.8432, "o", " np"]
[100.8604, "o", "id = 0;\r\r\n    for"]
[100.8779, "o", " (int s = 0; s"]
[100.8953, "o", " < nsegs; s++) {"]
[100.9127, "o", "\r\r\n        int pipe"]
[100.9301, "o", "fd"]
[100.9474, "o", "[2];\r\r\n       "]
[100.9647, "o", " int need"]
[100.982, "o", "_pipe = ("]
[100.9994, "o", "s + 1"]
[101.0167, "o", " < nsegs);\r\r\n        if"]
[101.0342, "o", " (need_pipe && pipe"]
[101.0517, "o", "(pipefd) < 0) {"]
[101.0691, "o", " error; }\r\r\n       "]
[101.0865, "o", " pid_t"]
[101.1038, "o", " pid = fork();\r\r\n        if ("]
[101.1213, "o", "pid == 0) {\r\r\n           "]
[101.1387, "o", " if (prev"]
[101.1561, "o", " >= 0)"]
[101.1735, "o", " { dup2"]
[101.1908, "o", "(prev,"]
[101.2081, "o", " 0); close(prev); }\r\r\n"]
[101.2256, "o", "            if ("]
[101.2429, "o", "prev"]
[101.2601, "o", " > "]
[101.2775, "o", "2) close(prev);"]
[101.2948, "o", " /* careful */\r\r\n            if"]
[101.2948, "o", " (need"]
[101.3123, "o", "_pipe) { dup2(pipefd["]
[101.3299, "o", "1], 1); close(pipefd"]
[101.3474, "o", "["]
[101.3647, "o", "0]);"]
[101.382, "o", " close(pipefd[1]); }\r\r\n"]
[101.3995, "o", "            if"]
[101.4169, "o", " (reds[s]."]
[101.4342, "o", "kind) { ..."]
[101.4516, "o", " redirect ... }\r\r\n           "]
[101.4689, "o", " close"]
[101.4862, "o", " pipe"]
[101.5034, "o", " ends...\r\r\n           "]
[101.5207, "o", " run"]
[101.538, "o", " the segment"]
[101.5553, "o", "'s command ("]
[101.5727, "o", "builtin"]
[101.5899, "o", " or exec) in the child"]
[101.6073, "o", " process"]
[101.6245, "o", "; _exit"]
[101.6419, "o", "\r\r\n        }\r\r\n        if ("]
[101.6593, "o", "prev >= 0)"]
[101.6767, "o", " close(prev);\r\r\n       "]
[101.6941, "o", " prev = need_pipe"]
[101.7115, "o", " ? pipefd[1]"]
[101.7289, "o", " (child"]
[101.7463, "o", "'s dup)"]
[101.7638, "o", " :"]
[101.7811, "o", " -1;\r\r\n       "]
[101.7985, "o", " if (need_pipe) close"]
[101.8159, "o", "(pipefd[0]);"]
[101.8333, "o", " /*"]
[101.8505, "o", " parent closes"]
[101.8678, "o", " read"]
[101.885, "o", " end after"]
[101.9024, "o", " fork */\r\r\n       "]
[101.9198, "o", " pids"]
[101.9371, "o", "[npid++] = pid;\r\r\n   "]
[101.9546, "o", " }\r\r\n    if (prev >= "]
[101.972, "o", "0) close(prev);\r\r\n   "]
[101.9894, "o", " wait for all"]
[102.0068, "o", " pids; return"]
[102.0241, "o", " the status of the last"]
[102.0415, "o", " one\r\r\n}\r\r\n```\r\r\n\r\r\n"]
[102.0589, "o", "The"]
[102.0761, "o", " child"]
[102.0933, "o", " logic"]
[102.1105, "o", " is"]
[102.1277, "o", " shared with the existing"]
[102.1451, "o", " execute"]
[102.1624, "o", " child \u2014 let me"]
[102.1797, "o", " refactor: a `"]
[102.1972, "o", "child_run(char"]
[102.2146, "o", " (*argv)[TOKLEN], int"]
[102.232, "o", " argc,"]
[102.2493, "o", " const struct redir *r)` that"]
[102.2667, "o", " does the"]
[102.284, "o", " builtin check + redirect"]
[102.3013, "o", " + exec and"]
