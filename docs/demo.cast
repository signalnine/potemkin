[29.4728, "o", " break;\r\r\n    }\r\r\n}\r\r\n"]
[29.4904, "o", "```"]
[29.5078, "o", "\r\r\nWait,"]
[29.5253, "o", " scanning from the"]
[29.5429, "o", " end finds the"]
[29.5605, "o", " last redirect. Good.\r\r\n\r\r\n"]
[29.5781, "o", "Builtins"]
[29.595, "o", " ("]
[29.6125, "o", "only when"]
[29.63, "o", " there's no redirect"]
[29.6475, "o", "?"]
[29.6649, "o", " Allow redirects"]
[29.6824, "o", " for"]
[29.6998, "o", " echo too \u2014"]
[29.7173, "o", " apply"]
[29.7347, "o", " redirects before"]
[29.7517, "o", " dispatch,"]
[29.7692, "o", " in the child"]
[29.7867, "o", " for"]
[29.8041, "o", " external"]
[29.8215, "o", " commands. For builtins,"]
[29.8391, "o", " apply the"]
[29.8566, "o", " redirect in the shell"]
[29.8742, "o", " process:"]
[29.8918, "o", " open the"]
[29.9093, "o", " fd, dup2"]
[29.9262, "o", ","]
[29.9436, "o", " run"]
[29.961, "o", " the builtin,"]
[29.9786, "o", " restore. That's"]
[29.9961, "o", " more work;"]
[30.0137, "o", " simpler: for builtins"]
[30.0313, "o", ", only apply the redirect"]
[30.0488, "o", " if it's a simple"]
[30.0664, "o", " one"]
[30.0839, "o", "\u2026"]
[30.1013, "o", " hmm"]
[30.1188, "o", ". Let"]
[30.1365, "o", "'s do it"]
[30.1541, "o", " right"]
[30.1717, "o", " with"]
[30.1891, "o", " save"]
[30.2066, "o", "/restore:\r\r\n\r\r\n"]
[30.2242, "o", "Actually, for simplicity and"]
[30.2417, "o", " correctness:"]
[30.2586, "o", " if there"]
[30.2761, "o", " are redirects,"]
[30.2937, "o", " handle them in"]
[30.3106, "o", " a fork"]
[30.3282, "o", "ed child"]
[30.3457, "o", " even for builtins?"]
[30.3633, "o", " Forking"]
[30.3808, "o", " for builtins is fine ("]
[30.3984, "o", "the shell"]
[30.416, "o", " forks,"]
[30.4335, "o", " the child"]
[30.451, "o", " opens"]
[30.4685, "o", " fds and"]
[30.486, "o", " runs the builtin and exits). But"]
[30.5036, "o", " then `cd`"]
[30.5211, "o", " in a child"]
[30.5381, "o", " doesn't affect the shell"]
[30.5557, "o", ". So"]
[30.5732, "o", ":"]
[30.5907, "o", "\r\r\n- `cd`"]
[30.6083, "o", " must"]
[30.6257, "o", " run in the shell process,"]
[30.6433, "o", " no redirect"]
[30.6609, "o", " support ("]
[30.6786, "o", "document"]
[30.696, "o", " it).\r\r\n-"]
[30.7136, "o", " Other builtins (echo,"]
[30.7312, "o", " help, exit)"]
[30.7488, "o", " can run"]
[30.7663, "o", " in the shell process without redirect"]
[30.7833, "o", " support, or"]
[30.8008, "o", " apply the"]
[30.8183, "o", " redirect temporarily.\r\r\n\r\r\nTo"]
[30.8359, "o", " keep the code"]
[30.8534, "o", " manageable:"]
[30.871, "o", " builtins run in the shell"]
[30.8881, "o", " process;"]
[30.9056, "o", " if there's a redirect,"]
[30.9232, "o", " apply it"]
[30.9407, "o", " around the builtin"]
[30.9583, "o", " by"]
[30.9757, "o", " saving"]
[30.9932, "o", "/restoring"]
[31.0107, "o", " fd 0/1"]
[31.0282, "o", "/2 via"]
[31.0458, "o", " dup"]
[31.0632, "o", "/dup2."]
[31.0807, "o", " Not"]
[31.0981, "o", " hard:\r\r\n\r\r\n```c\r\r\nint"]
[31.1159, "o", " old"]
[31.1333, "o", "out = dup"]
[31.1509, "o", "(1);"]
[31.1684, "o", "\r\r\nint fd ="]
[31.186, "o", " open(file,"]
[31.2036, "o", " flags"]
[31.221, "o", ","]
[31.2384, "o", " 06"]
[31.256, "o", "44);\r\r\n"]
[31.2735, "o", "dup2(fd, 1);\r\r\n"]
[31.2911, "o", "..."]
[31.3086, "o", " run builtin ...\r\r\ndup2"]
[31.3262, "o", "(oldout, "]
[31.3437, "o", "1); close"]
[31.3614, "o", "(oldout); close(fd);"]
[31.379, "o", "\r\r\n```"]
[31.3965, "o", "\r\r\n\r\r\nThat's"]
[31.4141, "o", " about 1"]
[31.4317, "o", "5 lines."]
[31.4493, "o", " Worth it."]
[31.4669, "o", " Let me implement"]
[31.4844, "o", " a helper:"]
[31.5014, "o", "\r\r\n\r\r\n```c\r\r\nstruct"]
[31.519, "o", " redir { int"]
[31.5366, "o", " kind;"]
[31.5542, "o", " /* 0"]
[31.5721, "o", " none, 1"]
[31.5895, "o", " in, 2 out"]
[31.6065, "o", ", 3 append */"]
[31.6241, "o", " const char *"]
[31.6417, "o", "file; };\r\r\nstatic void"]
[31.6587, "o", " apply_redir"]
[31.6763, "o", "(const struct redir *"]
[31.6939, "o", "r, int"]
[31.7114, "o", " *saved0, int *"]
[31.7291, "o", "saved1)"]
[31.7467, "o", " \r\r\n```\r\r\n\r\r\nHmm,"]
[31.7643, "o", " getting"]
[31.7817, "o", " complex. Alternative:"]
[31.7993, "o", " always"]
[31.8167, "o", " run"]
[31.8342, "o", " everything in a"]
[31.8518, "o", " child,"]
[31.8693, "o", " and make `cd`"]
[31.8869, "o", " special: `"]
[31.9045, "o", "cd` is"]
[31.9215, "o", " handled in the"]
[31.9391, "o", " parent before the"]
[31.9567, "o", " fork ("]
[31.9742, "o", "just"]
[31.9917, "o", " chdir,"]
[32.0093, "o", " don't"]
[32.027, "o", " exec"]
[32.0445, "o", ")."]
[32.062, "o", " This is a"]
[32.0796, "o", " classic"]
[32.0971, "o", " trick and"]
[32.1146, "o", " much simpler:\r\r\n\r\r\n"]
[32.1322, "o", "-"]
[32.1496, "o", " Parse the"]
[32.1672, "o", " line.\r\r\n- If the"]
[32.1848, "o", " command is"]
[32.2024, "o", " a builtin:"]
[32.2199, "o", "\r\r\n  - `"]
[32.2375, "o", "exit"]
[32.2549, "o", "` ->"]
[32.2725, "o", " cleanup"]
[32.2899, "o", " and return.\r\r\n  - `cd"]
[32.3076, "o", "` -> chdir in the parent ("]
[32.3253, "o", "redirects ignored"]
[32.3429, "o", ").\r\r\n  - `help` ->"]
[32.3605, "o", " print in"]
[32.3781, "o", " the parent.\r\r\n  - `echo"]
[32.3958, "o", "` -> fork"]
[32.4133, "o", " a child,"]
[32.4303, "o", " apply redirect,"]
[32.4473, "o", " print,"]
[32.465, "o", " exit. ("]
[32.4826, "o", "Or"]
[32.5001, "o", " print in the parent with redirect"]
[32.5177, "o", " save/restore"]
[32.5353, "o", "\u2026)"]
[32.5527, "o", "\r\r\n\r\r\nHmm,"]
[32.5703, "o", " forking"]
[32.5879, "o", " for echo means the"]
[32.6055, "o", " shell waits for"]
[32.623, "o", " it \u2014 that's fine"]
[32.6406, "o", ","]
[32.658, "o", " it's fast."]
[32.6757, "o", " But `"]
[32.6932, "o", "echo"]
[32.7106, "o", " hi >"]
[32.7282, "o", " file`:"]
[32.7457, "o", " child"]
[32.7631, "o", " writes to file"]
[32.7807, "o", "."]
[32.7981, "o", " Works.\r\r\n\r\r\n"]
[32.8157, "o", "Honestly, the cleanest"]
[32.8333, "o", " thing is:"]
[32.8509, "o", " a single"]
[32.8684, "o", " execution path:\r\r\n\r\r\n```"]
[32.886, "o", "c\r\r\nint"]
[32.9035, "o", " run_command(char"]
[32.9205, "o", " (*"]
[32.938, "o", "argv"]
[32.9554, "o", ")[]"]
[32.9729, "o", "...)"]
[32.9903, "o", " {\r\r\n    if"]
[33.0079, "o", " builtin"]
[33.0253, "o", " handles it"]
[33.0429, "o", " in-process"]
[33.06, "o", " ("]
[33.0775, "o", "help, cd, exit) ->"]
[33.0951, "o", " return status;"]
[33.1127, "o", "\r\r\n   "]
[33.1303, "o", " pid = fork();\r\r\n   "]
[33.1479, "o", " child:"]
[33.1654, "o", " apply redirect,"]
[33.1824, "o", " if"]
[33.1999, "o", " builtin"]
[33.2173, "o", " then"]
[33.2347, "o", " run_builtin()"]
[33.2523, "o", " else exec"]
[33.2698, "o", "v; _exit"]
[33.2875, "o", "(status)\r\r\n    parent: waitpid"]
[33.3051, "o", "; return status\r\r\n}\r\r\n```\r\r\n\r\r\n"]
[33.3228, "o", "`cd`"]
[33.3404, "o", " in the"]
[33.358, "o", " child"]
[33.3754, "o", " wouldn't"]
[33.393, "o", " persist"]
[33.4105, "o", ", so"]
[33.428, "o", " `cd` must run in the parent"]
[33.4457, "o", ". OK:"]
[33.4632, "o", " special-case cd"]
[33.4808, "o", " in the parent."]
[33.4984, "o", " Everything else (echo,"]
[33.5161, "o", " help)"]
[33.5338, "o", " forks;"]
[33.5514, "o", " help"]
[33.5688, "o", "/echo"]
[33.5864, "o", " run in the child. Actually"]
[33.6041, "o", " help"]
[33.6215, "o", " doesn't need"]
[33.6391, "o", " forking\u2026 but for"]
[33.6567, "o", " uniformity"]
[33.6743, "o", ":"]
[33.6917, "o", " everything"]
[33.7091, "o", " except cd"]
[33.7267, "o", "/exit forks."]
[33.7443, "o", " Wait \u2014 the"]
[33.7619, "o", " output of"]
[33.7794, "o", " a forked child"]
[33.797, "o", " also goes to the tty"]
[33.8145, "o", " ("]
[33.832, "o", "inherited)"]
[33.8496, "o", " \u2014"]
[33.8671, "o", " same as"]
[33.8841, "o", " exec. Good.\r\r\n\r\r\n"]
[33.9016, "o", "Hmm,"]
[33.9192, "o", " one"]
[33.9367, "o", " subtle point: if I"]
[33.9538, "o", " fork for"]
[33.9708, "o", " help, the"]
[33.9883, "o", " prompt"]
[34.0057, "o", " is printed after"]
[34.0233, "o", " waitpid \u2014"]
[34.0409, "o", " same as"]
[34.0584, "o", " any"]
[34.0758, "o", " command."]
[34.0935, "o", " Fine,"]
[34.1112, "o", " and uniform.\r\r\n\r\r\n"]
[34.1289, "o", "Actually, let me simplify"]
[34.1464, "o", " further:"]
[34.164, "o", " builtins `help"]
[34.181, "o", "` and `"]
[34.1986, "o", "echo` run in the"]
[34.2162, "o", " child ("]
[34.2338, "o", "after"]
[34.2512, "o", " redirect application), `cd` runs in"]
[34.2689, "o", " the parent,"]
[34.2865, "o", " and `exit` runs in the parent"]
[34.3041, "o", ".\r\r\n\r\r\n"]
[34.3217, "o", "Command lookup"]
[34.3392, "o", " in the child:\r\r\n```c"]
[34.3392, "o", "\r\r\n"]
[34.3569, "o", "char"]
[34.3743, "o", " prog[102"]
[34.392, "o", "4];\r\r\nif (argv[0"]
[34.4096, "o", "][0]=='"]
[34.4272, "o", "/') {\r\r\n    snprintf"]
