[802.5181, "o", "/whocares is a symlink to"]
[802.5386, "o", " /store"]
[802.559, "o", "!"]
[802.5794, "o", " readlink"]
[802.5999, "o", " /proc/self/exe follows"]
[802.6204, "o", " to the actual"]
[802.6409, "o", " file ="]
[802.6614, "o", " the /store path"]
[802.6818, "o", "."]
[802.7021, "o", " Either"]
[802.7224, "o", " is fine \u2014"]
[802.7429, "o", " if I"]
[802.7633, "o", " recognize"]
[802.7837, "o", " the path, it's"]
[802.8041, "o", " mine).\r\r\n\r\r\nAnd the"]
[802.8246, "o", " ptytest"]
[802.8451, "o", " v2 sequence:\r\r\n1."]
[802.8656, "o", " Startup"]
[802.8859, "o", "\r\r\n2. `"]
[802.9065, "o", "ls /data` ("]
[802.927, "o", "sanity"]
