[64.684, "o", " strcmp"]
[64.7011, "o", " on the"]
[64.7183, "o", " TOKLEN"]
[64.7354, "o", " array is fine.\r\r\n\r\r\n"]
[64.7525, "o", "Edge"]
[64.7696, "o", ": `>`"]
[64.7868, "o", " alone as"]
[64.804, "o", " the whole"]
[64.8211, "o", " command \u2192"]
[64.8382, "o", " n="]
[64.8554, "o", "1, cmd"]
[64.8725, "o", "_end:"]
[64.8897, "o", " the scan starts at i"]
[64.9068, "o", "=n-1=0,"]
[64.924, "o", " but I"]
[64.9411, "o", " start from i=1 so"]
[64.9583, "o", " a"]
[64.9753, "o", " leading redirect isn't treated as a"]
[64.9926, "o", " redirect\u2026"]
[65.0097, "o", " `"]
[65.0267, "o", "> file`"]
[65.0439, "o", " as a command:"]
[65.0611, "o", " tok[0"]
[65.0783, "o", "]=\">\", tok[1]=\"file\"."]
[65.0956, "o", " Scan"]
[65.1127, "o", " from i=1"]
[65.1299, "o", ": tok[1]=\"file\" is"]
[65.1472, "o", " not a redirect;"]
[65.1643, "o", " no redirect"]
[65.1814, "o", " found;"]
[65.1986, "o", " command ="]
[65.2157, "o", " \">\" \u2192 \""]
[65.2329, "o", "command not found\"."]
[65.2501, "o", " Acceptable"]
[65.2672, "o", " (the"]
[65.2844, "o", " shell doesn't support"]
[65.3015, "o", " leading redirects).\r\r\n\r\r\n"]
[65.3187, "o", "Hmm wait,"]
[65.3358, "o", " there's actually a bug: the scan"]
[65.3531, "o", " `for ("]
[65.3703, "o", "i"]
[65.3873, "o", " = n-"]
[65.4045, "o", "1; i >= 1; i"]
[65.4218, "o", "--)` \u2014 if"]
[65.439, "o", " the redirect is at index 0 ("]
[65.4562, "o", "e.g"]
[65.4734, "o", "., the"]
[65.4906, "o", " line"]
[65.5077, "o", " \"> file\"), it's"]
[65.5249, "o", " treated as the command"]
[65.5422, "o", " \">\". That's"]
[65.5593, "o", " fine.\r\r\n\r\r\n"]
[65.5764, "o", "But consider `"]
[65.5936, "o", "ls"]
[65.6106, "o", " / >"]
[65.6277, "o", " /"]
[65.6447, "o", "data/x`:"]
[65.6618, "o", " tokens: ls"]
[65.6789, "o", ", /, >,"]
[65.6961, "o", " /data/x"]
[65.7132, "o", " \u2192 n=4. Scan"]
[65.7303, "o", " i=3"]
[65.7474, "o", ":"]
[65.7644, "o", " \"/data/x\" no; i="]
[65.7816, "o", "2: \">\""]
[65.7987, "o", " yes \u2192"]
[65.8158, "o", " r"]
[65.8328, "o", ".file"]
[65.8498, "o", "=tok[3"]
[65.867, "o", "], cmd_end=2."]
[65.8842, "o", " execute"]
[65.9012, "o", "(tok"]
[65.9182, "o", ",2):"]
[65.9353, "o", " ls /"]
[65.9523, "o", " with redirect."]
[65.9694, "o", "\r\r\n\r\r\n`ls /"]
[65.9866, "o", " >/data/x`:"]
[66.0038, "o", " tokens: ls, /,"]
[66.0212, "o", " >/data/x (gl"]
[66.0384, "o", "ued) \u2192 n=3"]
[66.0556, "o", ","]
[66.0727, "o", " tok[2]=\""]
[66.0899, "o", ">\". Wait, the"]
[66.1071, "o", " glued"]
[66.1241, "o", " form: op"]
[66.1413, "o", " token"]
[66.1584, "o", " tok[2]=\""]
[66.1756, "o", ">\", then"]
[66.1928, "o", " target"]
[66.2098, "o", " tok[3"]
[66.227, "o", "]=\"/data/x\". n=4"]
[66.2443, "o", ". Same as"]
[66.2614, "o", " before."]
[66.2786, "o", " Good.\r\r\n\r\r\nNow the `"]
[66.2958, "o", "access"]
[66.3128, "o", "(prog, X_OK)` check"]
[66.3301, "o", " \u2014"]
[66.3471, "o", " prog"]
[66.3642, "o", " is a full path"]
[66.3814, "o", " like /"]
[66.3986, "o", "generated/bin/ls. Good.\r\r\n\r\r\n"]
[66.4159, "o", "Also,"]
[66.4331, "o", " add C"]
[66.4504, "o", "WD"]
[66.4675, "o", " search"]
[66.4847, "o", " for"]
[66.5018, "o", " relative"]
[66.5188, "o", " paths like `"]
[66.536, "o", "./"]
[66.5531, "o", "x` (access"]
[66.5702, "o", "(argv[0"]
[66.5874, "o", "])"]
[66.6045, "o", " with"]
[66.6215, "o", " a"]
[66.6386, "o", " ./ prefix) \u2014"]
[66.6558, "o", " `"]
[66.6728, "o", "./ls`"]
[66.69, "o", " works"]
[66.707, "o", " via"]
[66.724, "o", " the"]
[66.741, "o", " is_path check"]
[66.7582, "o", " ("]
[66.7752, "o", "starts with"]
[66.7923, "o", " '.',"]
[66.8094, "o", " not '/"]
[66.8265, "o", "'). Then the"]
[66.8437, "o", " BINDIRS"]
[66.8613, "o", " loop:"]
[66.8782, "o", " \"/generated/bin/"]
[66.8954, "o", "./ls\" \u2014"]
[66.9126, "o", " access"]
[66.9297, "o", " fails"]
[66.9468, "o", " ("]
[66.9637, "o", "no such file"]
[66.9809, "o", "). Then"]
[66.9981, "o", " `access"]
[67.0152, "o", "(\"./ls\", X_OK)`"]
[67.0324, "o", " succeeds if"]
[67.0496, "o", " it exists in the cwd."]
[67.0669, "o", " Handled.\r\r\n\r\r\n"]
[67.0841, "o", "is_path:"]
[67.1014, "o", " `argv[0][0]=='/'"]
[67.1186, "o", "`. What about `"]
[67.1358, "o", "~`?"]
[67.153, "o", " Skip.\r\r\n\r\r\nOK,"]
[67.1702, "o", " one more"]
[67.1873, "o", " potential issue:"]
[67.2044, "o", " when the child"]
[67.2217, "o", " execs"]
[67.2388, "o", " ls,"]
[67.256, "o", " ls"]
[67.273, "o", " writes to stdout"]
[67.2902, "o", " = tty"]
[67.3074, "o", ". Good.\r\r\n\r\r\nWhat"]
[67.3245, "o", " about the"]
[67.3417, "o", " `"]
[67.3587, "o", "wait"]
[67.3758, "o", "`"]
[67.3929, "o", " tool"]
[67.4099, "o", " later? The user"]
[67.427, "o", " can interact with the"]
[67.4443, "o", " tty"]
[67.4613, "o", " directly"]
[67.4784, "o", " (that's the"]
[67.4955, "o", " point of"]
[67.5127, "o", " tty mode).\r\r\n\r\r\nLet me"]
[67.5299, "o", " also"]
[67.5469, "o", " make the"]
[67.5641, "o", " prompt a"]
[67.5813, "o", " bit nicer: `"]
[67.5985, "o", "potemkin"]
[67.6157, "o", ">"]
[67.6328, "o", " `.\r\r\n\r\r\n"]
[67.6501, "o", "I think"]
[67.6674, "o", " the code is"]
[67.6845, "o", " robust. Let me"]
[67.7017, "o", " also handle the"]
[67.7189, "o", " case where"]
[67.736, "o", " is"]
[67.753, "o", "atty(0"]
[67.7702, "o", ")==0:"]
[67.7874, "o", " still run"]
[67.8046, "o", " (non"]
[67.8217, "o", "-tty"]
[67.8389, "o", ", read"]
[67.856, "o", " lines"]
[67.8731, "o", " from"]
[67.8902, "o", " piped"]
[67.9073, "o", " stdin,"]
[67.9245, "o", " EOF"]
[67.9415, "o", " \u2192 exit)."]
[67.9587, "o", " Useful"]
[67.9757, "o", " for"]
[67.9928, "o", " later"]
[68.0098, "o", " automation"]
[68.0269, "o", ": `sh"]
[68.044, "o", " -c"]
[68.0612, "o", "`? No"]
[68.0783, "o", " -c support. Keep it;"]
[68.0956, "o", " if"]
[68.1126, "o", " not"]
[68.1296, "o", " a tty, just skip the prompt"]
[68.1468, "o", "/banner"]
[68.1639, "o", " noise"]
[68.1809, "o", "? The banner is fine"]
[68.1981, "o", ".\r\r\n\r\r\n"]
[68.2152, "o", "Actually,"]
[68.2325, "o", " should I add `-c"]
[68.2498, "o", " \"command\"`"]
[68.267, "o", " support?"]
[68.2843, "o", " Really useful for"]
[68.3014, "o", " running"]
[68.3184, "o", " one-shot commands from"]
[68.3356, "o", " spawn"]
[68.3527, "o", "'s capture mode"]
[68.3699, "o", "\u2026"]
[68.3869, "o", " but the user"]
[68.404, "o", " asked for"]
[68.4212, "o", " an interactive shell"]
[68.4384, "o", " in tty"]
[68.4555, "o", ". -c"]
[68.4727, "o", " adds"]
[68.4897, "o", " complexity"]
[68.5068, "o", " ("]
[68.5238, "o", "quoting,"]
[68.541, "o", " etc.)."]
[68.5581, "o", " Skip \u2014"]
[68.5753, "o", " I can"]
[68.5925, "o", " just use"]
[68.6097, "o", " spawn directly for"]
[68.6268, "o", " one-shot"]
[68.644, "o", " commands."]
[68.6612, "o", " Mention"]
[68.6782, "o", " in help"]
[68.6954, "o", "? No"]
[68.7125, "o", ", keep help"]
[68.7297, "o", " to what actually"]
[68.7469, "o", " works.\r\r\n\r\r\n"]
[68.7641, "o", "Let me write the final"]
[68.7812, "o", " source"]
[68.7982, "o", ", compile"]
[68.8155, "o", " it,"]
[68.8327, "o", " and launch in tty mode.\r\r\n\r\r\n"]
[68.8498, "o", "One more"]
[68.8672, "o", " check on the"]
[68.8844, "o", " read"]
[68.9016, "o", "_line"]
[68.9187, "o", " overflow"]
[68.9359, "o", " branch:"]
[68.953, "o", " `while ("]
[68.9702, "o", "r"]
[68.9873, "o", ">0 &&"]
[69.0045, "o", " c!='\\n')`"]
[69.0217, "o", " \u2014 r is"]
[69.0388, "o", " always 1"]
[69.0559, "o", " there; it"]
[69.0731, "o", " should be `while ("]
[69.0903, "o", "c!='\\n"]
[69.1075, "o", "')"]
[69.1245, "o", " { r=read"]
[69.1416, "o", "(...); if (r<=0"]
[69.1588, "o", ") break; }`."]
[69.1761, "o", " Let me write it"]
[69.1933, "o", " correctly:\r\r\n\r\r\n```c\r\r\n"]
[69.2106, "o", "else"]
[69.2276, "o", " {\r\r\n    /*"]
[69.2448, "o", " line overflow: discard"]
[69.262, "o", " until"]
[69.279, "o", " end of line */\r\r\n    while ("]
[69.2963, "o", "c != '\\n') {\r\r\n       "]
[69.3137, "o", " ssize_t r"]
[69.3308, "o", "2 = read"]
[69.348, "o", "(STDIN"]
[69.3652, "o", "_FILENO,"]
[69.3824, "o", " &c, 1);\r\r\n       "]
[69.3997, "o", " if (r2"]
[69.4169, "o", " != 1) break;\r\r\n   "]
[69.4341, "o", " }\r\r\n    line"]
[69.4513, "o", "buf[LINE"]
[69.4685, "o", "LEN-1] ="]
[69.4857, "o", " 0;\r\r\n    return"]
[69.503, "o", " 0;\r\r\n}\r\r\n```\r\r\n\r\r\n"]
[69.5203, "o", "Good.\r\r\n\r\r\nNow"]
[69.5375, "o", " the full"]
[69.5547, "o", " source:\r\r\n\r\r\n```c\r\r\n"]
