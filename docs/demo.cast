[910.8479, "o", " program's"]
[910.8688, "o", " next `open()`"]
[910.8898, "o", " grabs fd 0 \u2014 the"]
[910.9108, "o", " file"]
[910.9316, "o", " descriptor"]
[910.9523, "o", " of the"]
[910.9733, "o", " \"file\""]
[910.9942, "o", " becomes the"]
[911.0151, "o", " supervisor's pipe, and"]
[911.0361, "o", " `cat`"]
[911.057, "o", " blocks forever"]
[911.0779, "o", " reading it"]
[911.099, "o", ". `head`"]
[911.12, "o", "'s fd 0"]
[911.141, "o", " was a *pipe* ("]
[911.162, "o", "not the session"]
[911.1828, "o", " TTY), so"]
[911.2038, "o", " it was left"]
[911.2247, "o", " alone"]
[911.2455, "o", " \u2014 and it"]
[911.2664, "o", " dead"]
[911.2872, "o", "locked"]
[911.308, "o", " behind"]
[911.3288, "o", " the stuck `cat`.\r\r\n\r\r\nFix:"]
[911.3498, "o", " before `exec`"]
[911.3708, "o", "'"]
[911.3916, "o", "ing a stage 0"]
[911.4125, "o", " that could"]
[911.4127, "o", " read"]
[911.4335, "o", " a file, point"]
[911.4545, "o", " its fd 0"]
[911.4754, "o", " at `/dev/null` so the"]
[911.4964, "o", " surgery"]
[911.5172, "o", " has"]
[911.538, "o", " nothing to target, and the"]
[911.559, "o", " file"]
[911.5799, "o", " lands on a"]
[911.6008, "o", " normal fd."]
[911.6218, "o", " First, clean up the stuck"]
[911.6428, "o", " session"]
[911.6638, "o", " \u2014"]
[911.6846, "o", " when the pty"]
[911.7055, "o", " master dies, the"]
[911.7265, "o", " stuck"]
[911.7473, "o", " tree gets"]
[911.7682, "o", " SIGHUP:\r\r\n\r\r\n"]
[911.8945, "o", "\r\r\n"]
[911.8945, "o", "\u001b[2m  wait pid=3559292 signal=KILL\r\r\n\u001b[0m"]
[911.9147, "o", "\u001b[2m    signal=9\r\r\n\u001b[0m"]
[921.2406, "o", "\u001b[2mKilled ptytest."]
[921.2616, "o", " The stuck"]
[921.2825, "o", " child processes should be dead"]
[921.3034, "o", " via SIGHUP from the pty"]
[921.3245, "o", " master"]
[921.3454, "o", " closing. Let me verify"]
[921.3664, "o", " quickly ("]
[921.3875, "o", "procscan"]
[921.4085, "o", " the shell"]
[921.4294, "o", "'s pid"]
[921.4504, "o", " \u2014 it should"]
[921.4714, "o", " be"]
[921.4922, "o", " gone),"]
[921.5131, "o", " then build the"]
[921.5341, "o", " fixed"]
[921.5549, "o", " shell.\r\r\n\r\r\nActually, let"]
[921.576, "o", "'s not"]
[921.597, "o", " waste a"]
[921.6179, "o", " turn on"]
[921.6389, "o", " verification \u2014 I'll build"]
[921.6598, "o", " the fixed shell"]
[921.6808, "o", " now. If the"]
[921.7018, "o", " stuck"]
[921.7227, "o", " processes"]
[921.7435, "o", " are still"]
[921.7644, "o", " around, I'll"]
[921.7854, "o", " find"]
[921.8063, "o", " out later"]
[921.8273, "o", " (they"]
[921.8483, "o", "'re"]
[921.8692, "o", " harmless"]
[921.8902, "o", " sleepers, and the"]
[921.9111, "o", " snapshot/rollback will"]
[921.932, "o", " clean them up"]
[921.9529, "o", ").\r\r\n\r\r\n"]
[921.9738, "o", "Fix"]
[921.9946, "o", " to sh (v2-based"]
[922.0156, "o", ", direct pipeline):\r\r\n- In"]
[922.0365, "o", " run_pipeline"]
[922.0574, "o", ", child"]
[922.0783, "o", " path"]
[922.0991, "o", ": if"]
[922.12, "o", " this"]
[922.1408, "o", " stage's"]
[922.1617, "o", " stdin is not the"]
[922.1827, "o", " inter"]
[922.2034, "o", "-stage pipe (i.e., stage "]
[922.2245, "o", "0),"]
[922.2454, "o", " before child_run"]
[922.2663, "o", " ("]
[922.2871, "o", "and therefore"]
[922.3081, "o", " before exec), dup2 /dev/null"]
[922.3291, "o", " onto fd 0.\r\r\n\r\r\nImplementation:"]
[922.3501, "o", " pass"]
[922.3709, "o", " a"]
[922.3917, "o", " `is"]
[922.4127, "o", "_first` flag to the child code,"]
[922.4337, "o", " or handle it inside the child"]
[922.4547, "o", " before"]
[922.4756, "o", " calling child_run:\r\r\n\r\r\n```c\r\r\n"]
[922.4965, "o", "if (pid"]
[922.5175, "o", " == 0) {\r\r\n    if"]
[922.5385, "o", " (prev"]
[922.5594, "o", " >= 0) {"]
[922.5803, "o", " dup2(prev,"]
[922.6013, "o", " STDIN_FILENO);"]
[922.6223, "o", " if (prev > 2) close"]
[922.6433, "o", "(prev); }\r\r\n    if ("]
[922.6643, "o", "pfd"]
[922.6852, "o", "[0] >= 0) close"]
[922.7062, "o", "(pfd[0]);\r\r\n    if"]
[922.7272, "o", " (pfd[1] >= "]
[922.7484, "o", "0) { dup2(pfd["]
[922.7694, "o", "1], STDOUT"]
[922.7903, "o", "_FILENO); close(pfd[1"]
[922.8114, "o", "]); }\r\r\n    if (prev"]
[922.8324, "o", " < 0) {\r\r\n       "]
[922.8535, "o", " /*"]
[922.8743, "o", " Stage 0"]
[922.8952, "o", " of a pipeline: fd 0"]
[922.9162, "o", " is the session's stdin"]
[922.9372, "o", " (pty"]
[922.9581, "o", " or"]
[922.9789, "o", " feed pipe).\r\r\n"]
[922.9999, "o", "         * The"]
[923.0208, "o", " session supervisor"]
[923.0418, "o", " re"]
[923.0626, "o", "writes the"]
[923.0836, "o", " stage child's"]
[923.1045, "o", " session"]
[923.1253, "o", "-TTY fd 0,\r\r\n        "]
[923.1463, "o", " *"]
[923.1671, "o", " which"]
[923.1879, "o", " makes the program's"]
[923.209, "o", " first open() land"]
[923.2301, "o", " on fd 0 and"]
[923.251, "o", " deadlocks.\r\r\n         *"]
[923.2721, "o", " Give it /dev/null"]
[923.2931, "o", " instead: the"]
[923.314, "o", " file opens on"]
[923.3349, "o", " a normal fd."]
[923.3558, "o", " */\r\r\n        int dn = open(\"/"]
[923.3769, "o", "dev/null\", O_RDWR);\r\r\n       "]
[923.398, "o", " if (dn >= 0) {"]
[923.4191, "o", " dup2(dn, STDIN_FILENO"]
[923.4401, "o", "); if (dn > 2)"]
[923.4612, "o", " close(dn); }\r\r\n    }"]
[923.4823, "o", "\r\r\n    child_run"]
[923.5032, "o", "(...);\r\r\n}\r\r\n```\r\r\n\r\r\nWait"]
[923.5244, "o", " \u2014 but"]
[923.5453, "o", " for a single command ("]
[923.5662, "o", "nseg==1), the child's"]
[923.5873, "o", " fd 0 ="]
[923.6082, "o", " session's stdin"]
[923.6292, "o", " \u2014 the"]
[923.6501, "o", " /dev/null must NOT be"]
[923.6711, "o", " applied"]
[923.6919, "o", " there (a"]
[923.7128, "o", " standalone `cat` in"]
[923.7337, "o", " tty mode must read the pty!)."]
[923.7547, "o", " The single"]
[923.7757, "o", "-command path"]
[923.7967, "o", " is a separate"]
[923.8176, "o", " code path"]
[923.8386, "o", " inside run_pipeline (the nseg"]
[923.8596, "o", "==1"]
[923.8805, "o", " branch) \u2014 that"]
[923.9015, "o", " one does not"]
[923.9224, "o", " do"]
[923.9432, "o", " the /dev/null."]
[923.9641, "o", " Only the"]
[923.9852, "o", " multi-stage child"]
[924.0062, "o", " does it"]
[924.0272, "o", " (and"]
[924.0482, "o", " only when"]
[924.0691, "o", " prev < 0, i.e.,"]
[924.0901, "o", " stage 0"]
[924.1111, "o", "; middle stages have prev"]
[924.132, "o", " >= 0 \u2192 fd 0"]
[924.153, "o", " = pipe \u2192 left"]
[924.174, "o", " alone).\r\r\n\r\r\nHmm"]
[924.1949, "o", " \u2014"]
[924.2157, "o", " one"]
[924.2365, "o", " question: in"]
[924.2574, "o", " capture mode, stage 0"]
[924.2783, "o", "'s fd"]
[924.2784, "o", " 0 = the"]
[924.2994, "o", " harness's feed pipe."]
[924.3204, "o", " dup2"]
[924.3413, "o", " /dev/null \u2192"]
[924.3622, "o", " stage 0 gets"]
[924.3832, "o", " /dev/null"]
[924.4042, "o", " \u2192 correct (the"]
[924.4252, "o", " stage must not eat the"]
[924.4462, "o", " scripted lines"]
[924.4673, "o", ")"]
[924.4882, "o", " \u2713."]
[924.5093, "o", " In tty mode"]
[924.5302, "o", ": fd 0 ="]
[924.5511, "o", " pty \u2192"]
[924.5721, "o", " /dev/null \u2192 the supervisor's surgery"]
[924.5931, "o", " is skipped ("]
[924.614, "o", "fd 0 \u2260"]
[924.635, "o", " session TTY) \u2192 the file opens"]
[924.656, "o", " on fd 3"]
[924.677, "o", " \u2713"]
[924.6978, "o", ".\r\r\n\r\r\nAlso"]
[924.7188, "o", ": should I"]
[924.7397, "o", " apply"]
[924.7605, "o", " /dev/null to"]
[924.7815, "o", " stages "]
[924.8023, "o", "1.."]
[924.8232, "o", "n"]
[924.8441, "o", " as well?"]
[924.865, "o", " Their fd 0"]
[924.886, "o", " = the pipe"]
[924.907, "o", " read end \u2014 the"]
[924.9279, "o", " surgery"]
[924.9487, "o", " doesn't touch it (evidence"]
[924.9698, "o", ": head"]
[924.9907, "o", " worked) \u2014"]
[925.0118, "o", " leave it alone."]
[925.0329, "o", "\r\r\n\r\r\nWhat about the stage"]
[925.0538, "o", " 0's B"]
[925.0748, "o", "UILTIN"]
[925.0956, "o", " ("]
[925.1164, "o", "echo in a"]
[925.1373, "o", " pipeline)?"]
[925.1583, "o", " The echo"]
[925.1793, "o", " builtin"]
[925.2002, "o", " in the"]
[925.2211, "o", " helper"]
[925.2419, "o", "\u2026"]
[925.2627, "o", " wait"]
[925.2835, "o", ","]
[925.3043, "o", " in the"]
[925.3252, "o", " direct-pipeline design ("]
[925.3462, "o", "v2), builtin"]
[925.3671, "o", " stages run in the child"]
[925.388, "o", " process (child_run"]
[925.409, "o", " handles"]
[925.4298, "o", " echo"]
[925.4506, "o", ")"]
[925.4714, "o", " \u2014 the child's fd 0 ="]
[925.4925, "o", " /dev/null ("]
[925.5134, "o", "my patch) \u2014"]
[925.5344, "o", " echo"]
[925.5552, "o", " doesn't"]
[925.5762, "o", " read stdin \u2014 no problem."]
[925.5972, "o", "\r\r\n\r\r\nOK,"]
[925.6181, "o", " let"]
[925.6389, "o", "'s rebuild"]
[925.6599, "o", " sh with"]
[925.681, "o", " this patch."]
[925.702, "o", " Take"]
[925.7229, "o", " v2's source"]
[925.7439, "o", " (the one"]
[925.7648, "o", " currently"]
[925.7857, "o", " at /"]
[925.8067, "o", "generated/bin/sh) and add the /"]
[925.8277, "o", "dev/null block"]
[925.8486, "o", " to the"]
[925.8695, "o", " child path of"]
[925.8904, "o", " the"]
[925.9112, "o", " pipeline."]
[925.9321, "o", " Note: the current"]
[925.9531, "o", " /generated/bin/sh"]
[925.9741, "o", " is v2 ("]
[925.995, "o", "direct pipeline,"]
[926.0159, "o", " both"]
[926.0368, "o", " nseg==1"]
[926.0577, "o", " and multi"]
