[529.0515, "o", " head"]
[529.0706, "o", " -1`"]
[529.0899, "o", " + pwd"]
[529.1091, "o", " + exit) worked!"]
[529.1284, "o", " The difference:"]
[529.1477, "o", " probe2's"]
[529.1669, "o", " child process execs"]
[529.1863, "o", " `sleep_ms` \u2014"]
[529.2055, "o", " hmm, E3's"]
[529.2249, "o", " head"]
[529.244, "o", " also execs."]
[529.2633, "o", " Hmm.\r\r\n\r\r\nLet me compare E3"]
[529.2826, "o", " (which worked) and probe2 ("]
[529.302, "o", "which failed):\r\r\n\r\r\nE3:"]
[529.3213, "o", "\r\r\n- Shell"]
