[801.841, "o", "\r\r\n   "]
[801.8614, "o", " int"]
[801.8818, "o", " len = 0;\r\r\n    for"]
[801.9024, "o", " (;;) {\r\r\n        char c"]
[801.9229, "o", ";\r\r\n        ssize_t r = read"]
[801.9436, "o", "(0, &c, 1"]
[801.9641, "o", ");\r\r\n        if (r"]
[801.9847, "o", " == 1"]
