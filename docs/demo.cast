[485.3832, "o", " would"]
[485.4022, "o", " feed the next line and"]
[485.4214, "o", " everything would"]
[485.4405, "o", " work.\r\r\n\r\r\nOptions:"]
[485.4597, "o", "\r\r\n\r\r\n"]
[485.4787, "o", "Option A:"]
[485.4979, "o", " the shell"]
[485.5171, "o", " processes the pipeline in a"]
[485.5363, "o", " way"]
[485.5553, "o", " where"]
[485.5743, "o", " the shell"]
[485.5935, "o", " itself (the"]
[485.6126, "o", " main process) is"]
[485.6318, "o", " reading stdin"]
[485.6509, "o", " during pipeline"]
[485.6701, "o", " execution."]
[485.6892, "o", " E.g"]
[485.7084, "o", ".:"]
[485.7274, "o", " fork the pipeline"]
[485.7466, "o", " into a helper"]
[485.7657, "o", " (as"]
[485.7848, "o", " in sh2), and"]
[485.8041, "o", " instead of waitpid, the shell"]
[485.8233, "o", " keeps looping"]
[485.8424, "o", " on read_line ("]
[485.8617, "o", "reading"]
[485.8807, "o", " the next input line"]
[485.8998, "o", "!),"]
[485.9188, "o", " queuing the"]
[485.9379, "o", " pending line"]
[485.9571, "o", ", and only"]
[485.9762, "o", " returns to"]
[485.9953, "o", " wait"]
[486.0143, "o", " on the helper when"]
[486.0334, "o", "\u2026 hmm,"]
[486.0525, "o", " but the shell"]
[486.0716, "o", " has to"]
[486.0907, "o", " wait"]
[486.1096, "o", " for the"]
[486.1287, "o", " command"]
[486.1477, "o", " to complete before"]
[486.1668, "o", " showing the"]
[486.1859, "o", " prompt / executing the next line ("]
[486.2051, "o", "otherwise the"]
[486.2242, "o", " output interleaves)."]
[486.2433, "o", " Actually"]
[486.2622, "o", " \u2014 is"]
[486.2813, "o", " that"]
[486.3003, "o", " so"]
[486.3193, "o", "?"]
[486.3383, "o", " A real interactive"]
[486.3573, "o", " shell waits for the"]
[486.3764, "o", " current"]
[486.3954, "o", " line's"]
[486.4144, "o", " command to"]
[486.4335, "o", " complete before"]
[486.4526, "o", " reading the next line. But in"]
[486.4717, "o", " this"]
[486.4907, "o", " harness's protocol, the"]
[486.5099, "o", " shell"]
[486.5289, "o", " reading ahead ("]
[486.548, "o", "consuming the next line"]
[486.5671, "o", " from the pipe"]
[486.5862, "o", " while the pipeline is"]
[486.6053, "o", " running)"]
[486.6245, "o", " is exactly what the harness wants"]
[486.6435, "o", " to see (the program is blocked"]
[486.6626, "o", " reading stdin \u2192"]
[486.6817, "o", " feed the next line"]
[486.7008, "o", ")!\r\r\n\r\r\nSo"]
[486.72, "o", ":"]
[486.7389, "o", " a read-ahead"]
[486.758, "o", " design"]
[486.777, "o", ":\r\r\n1."]
[486.7961, "o", " The shell forks"]
[486.8153, "o", " the pipeline"]
