[39.3054, "o", " into"]
[39.3228, "o", " an 8"]
[39.3405, "o", "192 buffer;"]
[39.3581, "o", " in canonical mode,"]
[39.3757, "o", " one read"]
[39.3927, "o", "() returns a"]
[39.4103, "o", " whole line ("]
[39.4279, "o", "up to"]
[39.4449, "o", " the"]
[39.4625, "o", " canonical limit)."]
[39.4801, "o", " Handle"]
[39.4976, "o", " EINTR"]
[39.5152, "o", "."]
[39.5326, "o", " If the buffer"]
[39.5502, "o", " fills up"]
[39.5678, "o", " without a newline"]
[39.5855, "o", " (line"]
[39.6031, "o", " longer than 8192),"]
[39.6202, "o", " the remainder"]
[39.6379, "o", " stays"]
[39.6554, "o", " in the"]
[39.673, "o", " tty buffer;"]
[39.6906, "o", " subsequent reads"]
[39.7082, "o", " pick"]
[39.7257, "o", " it up."]
[39.7434, "o", " My accumulation loop"]
[39.761, "o", " handles"]
[39.7785, "o", " that:"]
[39.796, "o", " keep appending"]
[39.8137, "o", " reads until"]
[39.8314, "o", " I find a"]
[39.8491, "o", " '\\n"]
