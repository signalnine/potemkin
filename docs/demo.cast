[78.3881, "o", ","]
[78.4052, "o", " and"]
[78.4223, "o", " \">>\""]
[78.4397, "o", " has tok[i][1"]
[78.457, "o", "]=='>'."]
[78.4742, "o", " OK"]
[78.4914, "o", ".\r\r\n\r\r\nAlso, the `"]
[78.5087, "o", ">>` check: tok[i][1"]
[78.526, "o", "]=='>'"]
[78.5433, "o", " means append."]
[78.5605, "o", " For"]
[78.5777, "o", " \"<\", tok[i]["]
[78.595, "o", "1] is 0"]
[78.6122, "o", ","]
[78.6293, "o", " but I"]
[78.6465, "o", " only check"]
[78.6637, "o", " when"]
[78.6809, "o", " op"]
[78.698, "o", " is"]
[78.7151, "o", " '"]
[78.7322, "o", ">'."]
[78.7493, "o", " Fine.\r\r\n\r\r\nA"]
[78.7665, "o", " possible"]
[78.7836, "o", " warning:"]
[78.8009, "o", " unused `"]
[78.8181, "o", "found`"]
[78.8353, "o", " path"]
[78.8524, "o", "\u2026"]
[78.8695, "o", " fine"]
[78.8866, "o", ","]
[78.9037, "o", " it's used.\r\r\n\r\r\nt"]
[78.9209, "o", "cc"]
[78.938, "o", " static"]
[78.9551, "o", " musl"]
[78.9725, "o", " \u2014"]
[78.9896, "o", " all"]
