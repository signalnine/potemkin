[484.466, "o", " reading stdin, and"]
[484.4851, "o", " if"]
[484.5042, "o", " that condition"]
[484.5233, "o", " isn't met within a short"]
[484.5425, "o", " grace G ("]
[484.5617, "o", "\u22481\u2013"]
[484.5808, "o", "5ms) after the"]
[484.6, "o", " command's"]
[484.6191, "o", " completion, it closes the"]
[484.6383, "o", " input"]
[484.6572, "o", " channel and"]
[484.6763, "o", " ends the session.**\r\r\n\r\r\nIn"]
[484.6955, "o", " a multi"]
[484.7147, "o", "-stage pipeline, the"]
[484.7338, "o", " shell"]
[484.7527, "o", " can't reach"]
[484.7719, "o", " the stdin read until"]
