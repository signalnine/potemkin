[40.5516, "o", " read"]
[40.5691, "o", " returns -"]
[40.5866, "o", "1 EINTR"]
[40.6043, "o", "; I continue"]
[40.6218, "o", ";"]
[40.6393, "o", " the"]
[40.6568, "o", " partially typed line"]
[40.6744, "o", " is"]
[40.6919, "o", " discarded (the tty"]
[40.7095, "o", " driver"]
[40.727, "o", " in canonical mode discards the"]
[40.7447, "o", " current line"]
[40.7622, "o", " buffer on"]
[40.7798, "o", " EINTR"]
[40.7974, "o", "? actually"]
[40.815, "o", ", the"]
[40.8327, "o", " partially typed line"]
[40.8503, "o", " remains in the"]
[40.8679, "o", " terminal"]
[40.8848, "o", "'s line buffer"]
[40.9018, "o", "! Hmm"]
[40.9194, "o", ". In canonical mode,"]
[40.937, "o", " when SIGINT"]
[40.9542, "o", " interrupts read, the"]
[40.9719, "o", " current line buffer is"]
[40.9895, "o", "\u2026 the"]
[41.0065, "o", " terminal"]
[41.024, "o", " keeps the"]
[41.0416, "o", " partial line; the next"]
[41.0592, "o", " read returns it. So the"]
[41.0769, "o", " partial line persists, and the user"]
[41.0945, "o", " can continue"]
[41.1121, "o", " typing \u2014"]
[41.1298, "o", " like"]
