[323.2566, "o", " when the harness"]
[323.275, "o", " closes"]
[323.2933, "o", "/stops feeding.\r\r\n\r\r\n"]
[323.3118, "o", "A"]
[323.3301, "o", " decisive test:"]
[323.3485, "o", " a minimal"]
[323.3669, "o", " C program that"]
[323.3852, "o", " mimics the"]
[323.4036, "o", " shell's"]
