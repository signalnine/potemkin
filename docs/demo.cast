[529.3599, "o", " \"echo a | head -1\""]
[529.3792, "o", "\r\r\n- Shell forks"]
[529.3985, "o", " the echo child"]
[529.4178, "o", " process"]
[529.4369, "o", " ("]
[529.4561, "o", "no exec), forks the head child process"]
[529.4755, "o", " (execs"]
[529.4948, "o", " head)\r\r\n- The"]
[529.514, "o", " shell"]
[529.5332, "o", " wait"]
[529.5524, "o", "pids"]
[529.5716, "o", " echo"]
[529.5909, "o", " (im"]
[529.6102, "o", "mediate), then waitpids head ("]
[529.6296, "o", "about 1"]
[529.6488, "o", "\u20135ms)\r\r\n- Head exits"]
[529.6682, "o", " \u2192"]
[529.6874, "o", " shell"]
[529.7065, "o", " loops \u2192"]
[529.7258, "o", " read_line"]
[529.7451, "o", " \u2192"]
[529.7642, "o", " the harness"]
[529.7834, "o", " feeds \""]
[529.8028, "o", "pwd"]
[529.822, "o", "\\n\" \u2192 the shell"]
[529.8413, "o", " reads it"]
[529.8606, "o", " (consumed)"]
[529.88, "o", " \u2192 feeds \""]
[529.8993, "o", "exit\\n\" \u2192"]
[529.9187, "o", " consumed \u2192 exit\r\r\n\r\r\n"]
[529.9381, "o", "probe2:\r\r\n-"]
[529.9574, "o", " Reads line 1 \"one | pipe"]
[529.9769, "o", "\"\r\r\n- Forks"]
[529.9962, "o", " a child process that execs sleep_ms"]
[530.0157, "o", " 10 ("]
[530.0351, "o", "exits"]
[530.0545, "o", " at t"]
