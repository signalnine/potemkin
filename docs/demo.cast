[71.9339, "o", "\r\r\n                    ssize_t r2 = read"]
[71.9512, "o", "(STDIN_FILENO, &c, "]
[71.9684, "o", "1);\r\r\n                    if (r2"]
[71.9857, "o", " != 1) break;\r\r\n               "]
[72.003, "o", " }\r\r\n                linebuf[LINE"]
