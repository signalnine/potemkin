[63.2101, "o", " to"]
[63.2271, "o", " save"]
[63.2441, "o", " tokens? The"]
[63.2611, "o", " pattern I"]
[63.2782, "o", " set"]
[63.2952, "o", " with ls"]
[63.3123, "o", " included"]
[63.3292, "o", " it. Let me"]
[63.3463, "o", " skip"]
[63.3633, "o", " the duplicate"]
[63.3805, "o", " write"]
[63.3975, "o", " this time"]
[63.4147, "o", " \u2014"]
[63.4317, "o", " /store"]
[63.4488, "o", " has the source"]
[63.4659, "o", ". Hmm,"]
[63.4831, "o", " /src"]
[63.5002, "o", " is"]
[63.5172, "o", " described as"]
[63.5343, "o", " where"]
[63.5513, "o", " I put sources"]
[63.5685, "o", " (\""]
[63.5855, "o", "sources"]
[63.6026, "o", "\")."]
[63.6196, "o", " Let me write it for consistency."]
[63.6368, "o", " Actually, it"]
[63.6539, "o", " doubles the token cost"]
[63.6711, "o", " of the source"]
[63.6882, "o", "."]
[63.7052, "o", " The"]
[63.7222, "o", " compile tool already saves the source in /"]
[63.7395, "o", "store. Let me skip the /"]
[63.7567, "o", "src copy.\r\r\n\r\r\n"]
[63.7739, "o", "Let me also double-check the"]
[63.7911, "o", " `"]
[63.8081, "o", ">>`"]
[63.8252, "o", " tokenize: `"]
[63.8423, "o", "s"]
[63.8594, "o", "[i]=='>'` then `"]
[63.8766, "o", "if (s[i"]
[63.8938, "o", "]=='>')` \u2014"]
[63.9109, "o", " I wrote"]
[63.928, "o", " `tok[i"]
[63.9452, "o", "][1]=="]
[63.9624, "o", "'>"]
[63.9793, "o", " '`. Let me"]
[63.9965, "o", " write"]
[64.0135, "o", " it cleanly:\r\r\n\r\r\n```c\r\r\n"]
[64.0135, "o", "if"]
[64.0308, "o", " (s[i]=='>' || s[i"]
[64.048, "o", "]=='<') {\r\r\n    char"]
[64.0652, "o", " op = s[i"]
[64.0824, "o", "++];\r\r\n    char *"]
[64.0997, "o", "t = tok"]
[64.117, "o", "[n++];\r\r\n    t"]
[64.1341, "o", "[0] = op;\r\r\n   "]
[64.1514, "o", " if (op == '>' && s[i"]
[64.1686, "o", "] == '>') {"]
[64.1858, "o", " t[1"]
[64.2029, "o", "]='>';"]
[64.22, "o", " t[2"]
[64.2371, "o", "]=0; i++; }"]
[64.2543, "o", "\r\r\n    else t[1]=0"]
[64.2715, "o", ";\r\r\n    if (i"]
[64.2887, "o", "<L &&"]
[64.3058, "o", " s[i]!='"]
[64.3229, "o", " ' && s[i]!='\\t')"]
[64.3401, "o", " {"]
[64.3571, "o", "\r\r\n        char *"]
[64.3743, "o", "f = tok[n++];"]
[64.3915, "o", "\r\r\n        size_t j = 0"]
[64.4088, "o", ";\r\r\n        while (i<L &&"]
[64.4261, "o", " s[i]!=' ' && s[i]!='"]
[64.4433, "o", "\\t' && j"]
[64.4605, "o", "<TOKLEN-1)"]
[64.4777, "o", " f[j"]
[64.4949, "o", "++]=s[i++];\r\r\n       "]
[64.5121, "o", " f[j]=0;\r\r\n    }"]
[64.5294, "o", "\r\r\n}\r\r\n```\r\r\n\r\r\n"]
[64.5465, "o", "And in the redirect"]
[64.5637, "o", " scan"]
[64.5807, "o", ", check `"]
[64.5979, "o", "!strcmp(tok[i],\">\")"]
[64.6151, "o", "||!strcmp(tok[i],\">>\")"]
[64.6324, "o", "||!strcmp(tok[i],\"<\")"]
[64.6497, "o", "`"]
