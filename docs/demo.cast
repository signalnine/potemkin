[817.3556, "o", "8dfbd4"]
[817.3762, "o", "caa951ee9dfaf"]
[817.3968, "o", "44f15c53"]
[817.4174, "o", "27ad9d8e2"]
[817.438, "o", "af"]
[817.4584, "o", "29be07"]
[817.4789, "o", "a5a9e44fa"]
[817.4996, "o", "ac75"]
[817.5201, "o", "6fa754c/bin"]
[817.5407, "o", " \u2713)."]
[817.5612, "o", " The hash of 30edf"]
[817.5818, "o", "3... is my `head` ("]
[817.6025, "o", "\u2713"]
[817.6228, "o", " from the compile output).\r\r\n\r\r\nSo the"]
[817.6435, "o", " real"]
[817.664, "o", " cat and"]
[817.6847, "o", " head binaries are"]
[817.7052, "o", " indeed running"]
[817.7258, "o", " (no proxy"]
[817.7463, "o", " substitution!)."]
[817.7668, "o", " Which means"]
[817.7874, "o", " my cat with"]
[817.808, "o", " file arguments is"]
[817.8286, "o", " blocked on read(fd 0"]
[817.8491, "o", ") \u2014"]
[817.8697, "o", " which"]
[817.8901, "o", " my code should never"]
[817.9107, "o", " do!\r\r\n\r\r\nWait"]
[817.9313, "o", "... let me re"]
[817.9519, "o", "-read"]
[817.9723, "o", " my cat code very carefully:\r\r\n\r\r\n```"]
[817.9929, "o", "c\r\r\nstatic int"]
[818.0135, "o", " cat_fd(int fd,"]
[818.0341, "o", " const char *name)\r\r\n{\r\r\n"]
[818.0548, "o", "    char buf["]
[818.0753, "o", "8192];\r\r\n   "]
[818.096, "o", " for (;;) {\r\r\n       "]
[818.1168, "o", " ssize_t"]
[818.1375, "o", " r = read(fd,"]
[818.1581, "o", " buf,"]
[818.1787, "o", " sizeof buf);\r\r\n        ...\r\r\n   "]
[818.1995, "o", " }\r\r\n    return 0;\r\r\n"]
[818.2203, "o", "}"]
[818.2408, "o", "\r\r\n\r\r\nstatic int cat_file(const char *"]
[818.2616, "o", "path)\r\r\n{\r\r\n    if (!"]
[818.2823, "o", "path || !"]
[818.3029, "o", "*path ||"]
[818.3236, "o", " !strcmp(path,"]
[818.3443, "o", " \"-\"))"]
[818.365, "o", "\r\r\n        return cat_fd"]
[818.3856, "o", "(STDIN_FILENO, \"stdin\");\r\r\n"]
[818.4064, "o", "    int fd = open(path"]
[818.4271, "o", ", O_RDONLY);\r\r\n    ...\r\r\n"]
[818.4478, "o", "}\r\r\n\r\r\nint main"]
[818.4686, "o", "(int argc, char"]
[818.4893, "o", " **argv)\r\r\n{\r\r\n   "]
[818.51, "o", " int"]
[818.5305, "o", " rc = 0;\r\r\n    if"]
[818.5513, "o", " (argc < "]
[818.572, "o", "2) {\r\r\n        rc = cat"]
[818.5926, "o", "_file(0);\r\r\n    } else"]
[818.6134, "o", " {\r\r\n        for (int i ="]
[818.6341, "o", " 1; i < argc; i"]
[818.6549, "o", "++)\r\r\n            rc"]
[818.6755, "o", " |= cat_file(argv[i]);\r\r\n   "]
[818.6963, "o", " }\r\r\n    return rc;\r\r\n}"]
[818.717, "o", "\r\r\n```\r\r\n\r\r\n"]
[818.7377, "o", "For cat"]
[818.7583, "o", " /"]
[818.7789, "o", "data"]
[818.7995, "o", "/readme.txt: argc=2"]
[818.8202, "o", " \u2192 cat_file(\"/data/readme.txt"]
[818.8409, "o", "\") \u2192 path"]
[818.8615, "o", " is non-empty"]
[818.8822, "o", ", not \"-\" \u2192 open"]
[818.9029, "o", "(path, O_RDONLY) \u2192 read"]
[818.9237, "o", "(fd"]
[818.9442, "o", "=3)...\r\r\n\r\r\nThe"]
[818.9648, "o", " blocked"]
[818.9853, "o", " syscall is read(0,"]
[819.006, "o", " ...) \u2014 fd=0. For"]
[819.0268, "o", " this to happen in"]
[819.0474, "o", " my"]
[819.0679, "o", " code,"]
[819.0885, "o", " cat"]
[819.1089, "o", "_fd(0)"]
[819.1295, "o", " would have to be called"]
[819.1501, "o", " \u2014"]
[819.1706, "o", " only"]
[819.191, "o", " in the case"]
[819.2116, "o", " of `cat"]
[819.2322, "o", "` with no arguments or `cat"]
[819.253, "o", " -`..."]
[819.2737, "o", " or"]
[819.2942, "o", " open()"]
[819.3149, "o", " returned 0"]
[819.3355, "o", "!!!\r\r\n\r\r\n"]
[819.356, "o", "If open"]
[819.3767, "o", "(\"/data/readme.txt\", O_RDONLY"]
[819.3974, "o", ") returned fd 0!"]
[819.4182, "o", "?!"]
[819.4387, "o", "? That"]
[819.4594, "o", " happens when"]
[819.48, "o", " fd 0"]
[819.5007, "o", " was closed"]
[819.5213, "o", " at the"]
[819.542, "o", " moment of"]
[819.5626, "o", " the open! If the"]
[819.5833, "o", " child process's fd 0 was"]
[819.604, "o", " closed before"]
[819.6246, "o", " the exec"]
[819.6452, "o", "... no wait"]
[819.6659, "o", " \u2014 the"]
[819.6865, "o", " open"]
[819.7071, "o", " inside"]
[819.7276, "o", " cat ("]
[819.7482, "o", "after"]
[819.7688, "o", " the exec)"]
[819.7894, "o", " returns"]
[819.8099, "o", " the lowest"]
[819.8306, "o", " free fd. If"]
[819.8512, "o", " the child process"]
[819.8719, "o", " closed fd 0"]
[819.8925, "o", " before the exec, then"]
[819.9132, "o", " the"]
[819.9339, "o", " open"]
[819.9545, "o", " inside cat would return 0"]
[819.9753, "o", "!\r\r\n\r\r\n"]
[819.9959, "o", "Who closed fd 0 in the"]
[820.0166, "o", " child process?! Let me look at my"]
[820.0373, "o", " child"]
[820.0579, "o", " code again:\r\r\n\r\r\n```c\r\r\nif"]
[820.0786, "o", " (pid == 0) {\r\r\n"]
[820.0993, "o", "    if ("]
[820.1199, "o", "prev"]
[820.1404, "o", " >= 0) {"]
[820.1611, "o", " dup"]
[820.1816, "o", "2(prev,"]
[820.2023, "o", " STDIN_FILENO"]
[820.2023, "o", ");"]
[820.223, "o", " if (prev > "]
[820.2437, "o", "2)"]
[820.2643, "o", " close(prev); }\r\r\n    if ("]
[820.285, "o", "pfd[0] >= 0"]
[820.3059, "o", ") close(pfd[0]);\r\r\n"]
[820.3266, "o", "    if (pfd[1]"]
[820.3474, "o", " >= 0) { dup2(p"]
[820.3681, "o", "fd[1],"]
[820.3888, "o", " STDOUT_FILENO); close(pfd[1"]
[820.4095, "o", "]); }\r\r\n   "]
[820.4302, "o", " child_run"]
[820.4509, "o", "(...);\r\r\n}\r\r\n```\r\r\n\r\r\n"]
[820.4716, "o", "Stage 0 ("]
[820.4923, "o", "cat): prev"]
[820.513, "o", "=-1"]
[820.5337, "o", " (no dup2"]
[820.5543, "o", "/close"]
[820.5748, "o", " on fd"]
[820.5955, "o", " 0), pfd[0"]
[820.6163, "o", "] ="]
[820.637, "o", " the pipe's"]
[820.6576, "o", " read"]
[820.6782, "o", " end ("]
