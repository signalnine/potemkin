[22.579, "o", " fprintf(stderr, \""]
[22.5965, "o", "shell: cannot execute %s"]
[22.6141, "o", ": %s\\n\", prog,"]
[22.6317, "o", " strerror(errno));\r\r\n   "]
[22.6492, "o", " _exit(1"]
[22.6661, "o", "27);\r\r\n}\r\r\n"]
[22.6837, "o", "waitpid(pid"]
[22.7011, "o", ", &"]
[22.718, "o", "status, 0);\r\r\n"]
[22.7356, "o", "return status:"]
[22.7532, "o", " if WIF"]
[22.7707, "o", "EXITED"]
[22.7882, "o", " -> WEXITSTATUS"]
[22.8051, "o", ", if W"]
[22.8226, "o", "IFSIGN"]
[22.8401, "o", "ALED -> 1"]
[22.8577, "o", "28+"]
[22.8753, "o", "sig\r\r\n```\r\r\n\r\r\nBuiltins:\r\r\n"]
[22.8924, "o", "- `help`: list"]
[22.9099, "o", " available commands\r\r\n- `echo ["]
[22.9274, "o", "args]`: print"]
[22.9449, "o", " them"]
[22.9622, "o", "\r\r\n- `cd"]
[22.9797, "o", " ["]
[22.9971, "o", "dir]`: chdir"]
[23.0146, "o", "\r\r\n- `exit"]
[23.0322, "o", " ["]
[23.0496, "o", "code]`:"]
[23.0671, "o", " return"]
[23.0845, "o", "\r\r\n\r\r\n"]
[23.1018, "o", "Prompt:"]
[23.1193, "o", " `potemkin> `"]
[23.1363, "o", " flush"]
[23.1537, "o", " stdout.\r\r\n\r\r\nAlso,"]
[23.1707, "o", " print"]
[23.188, "o", " a welcome banner at startup:"]
[23.2056, "o", " something like \"Potemkin"]
[23.2231, "o", "OS shell \u2014"]
[23.2407, "o", " type"]
[23.258, "o", " 'help'"]
[23.2755, "o", "\".\r\r\n\r\r\n"]
[23.293, "o", "Edge"]
[23.3105, "o", " cases:"]
[23.3281, "o", " empty line"]
[23.3456, "o", " ->"]
[23.3631, "o", " just"]
[23.3806, "o", " print the prompt"]
[23.398, "o", " again."]
[23.4155, "o", " Lines"]
[23.4329, "o", " over 8192 ->"]
[23.4504, "o", " truncate or just"]
[23.4673, "o", " read"]
[23.4847, "o", " what"]
[23.5021, "o", " fgets"]
[23.5194, "o", " gives"]
[23.5368, "o", " (fgets returns a"]
[23.5544, "o", " partial line"]
[23.5719, "o", " without newline;"]
[23.5895, "o", " handle"]
[23.6068, "o", " by"]
[23.6241, "o", " continuing?"]
[23.6416, "o", " Keep it simple: if"]
[23.6592, "o", " no newline and"]
[23.6767, "o", " EOF"]
[23.694, "o", " not reached, print"]
[23.711, "o", " a warning and"]
[23.7279, "o", " discard"]
[23.7453, "o", " the rest"]
[23.7628, "o", " of the line?"]
[23.7803, "o", " Even simpler:"]
[23.7972, "o", " treat it as"]
[23.8146, "o", " a complete line;"]
[23.8321, "o", " fine for"]
[23.8497, "o", " v1"]
[23.8671, "o", ".)\r\r\n\r\r\nHandling `"]
[23.8847, "o", "~`?"]
[23.9022, "o", " Skip.\r\r\n\r\r\n"]
[23.9198, "o", "Variable expansion"]
[23.9373, "o", " ($"]
[23.9547, "o", "HOME)? Skip"]
[23.9722, "o", " for v1 \u2014"]
[23.9897, "o", " I can"]
[24.0071, "o", " add it later"]
[24.0245, "o", " if the user"]
[24.0414, "o", " asks.\r\r\n\r\r\n"]
[24.0589, "o", "OK,"]
[24.0763, "o", " now the"]
[24.0932, "o", " fork"]
[24.1105, "o", " question: when the"]
[24.128, "o", " shell"]
[24.1453, "o", " forks"]
[24.1627, "o", ", the child inherits the"]
[24.1802, "o", " tty. The"]
[24.1977, "o", " child"]
[24.2151, "o", "'s"]
[24.2324, "o", " output goes to the"]
[24.2499, "o", " tty,"]
[24.2673, "o", " so the"]
[24.2847, "o", " user sees the"]
[24.3022, "o", " command's output"]
[24.3196, "o", " interleaved"]
[24.3371, "o", " with"]
[24.3545, "o", " the shell"]
[24.3719, "o", "'s"]
[24.3893, "o", " prompts"]
[24.4066, "o", " \u2014 exactly"]
[24.4241, "o", " like a"]
[24.4415, "o", " real shell."]
[24.459, "o", " Good.\r\r\n\r\r\n"]
[24.4764, "o", "One concern: the"]
[24.4939, "o", " spawn"]
[24.5113, "o", " wrapper"]
[24.5286, "o", " says \"each program"]
[24.5461, "o", " gets its own cgroup"]
[24.5637, "o", " capped at mem"]
[24.5812, "o", "_mb\". Fork"]
[24.5988, "o", "s"]
[24.6161, "o", " from within the shell"]
[24.6336, "o", " are inside"]
[24.6511, "o", " that cgroup \u2014"]
[24.6687, "o", " fine.\r\r\n\r\r\nAnother"]
[24.6863, "o", " concern: does the"]
[24.7038, "o", " tty"]
[24.7212, "o", " go"]
[24.7385, "o", " back to the"]
[24.7561, "o", " shell after a"]
[24.7736, "o", " child"]
[24.791, "o", " exits? Yes, the child"]
[24.8079, "o", " closes the"]
[24.8255, "o", " tty"]
[24.8428, "o", " on exit, and the shell"]
[24.8604, "o", " ("]
[24.8778, "o", "still"]
[24.8952, "o", " attached)"]
[24.9121, "o", " prints the"]
[24.9291, "o", " next prompt.\r\r\n\r\r\nLet me also"]
[24.9466, "o", " set the shell's"]
[24.9642, "o", " working directory"]
[24.9817, "o", " \u2014"]
[24.9985, "o", " it"]
[25.0159, "o", " inherits cwd"]
[25.0334, "o", " from spawn,"]
[25.0503, "o", " probably"]
[25.0677, "o", " /.\r\r\n\r\r\n"]
[25.0852, "o", "Name:"]
[25.1028, "o", " `"]
[25.1202, "o", "sh`."]
[25.1378, "o", " Path"]
[25.1547, "o", " /generated/bin/sh.\r\r\n\r\r\nLet me"]
[25.1723, "o", " write the code carefully."]
[25.1893, "o", "\r\r\n\r\r\n```c\r\r\n#include <stdio.h"]
[25.2069, "o", ">\r\r\n#include <stdlib.h>\r\r\n"]
[25.2245, "o", "#include <string.h>\r\r\n#include "]
