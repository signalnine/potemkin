[531.8321, "o", " at t=0"]
[531.8515, "o", "."]
[531.8707, "o", "01 the"]
[531.89, "o", " parent"]
[531.9092, "o", " process reads \"two\" and"]
[531.9286, "o", " proceeds to"]
