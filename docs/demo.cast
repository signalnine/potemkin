[340.6105, "o", " line "]
[340.6291, "o", "2"]
[340.6475, "o", " (the pipeline"]
[340.6661, "o", " line)."]
[340.6846, "o", " The"]
[340.703, "o", " difference between probe and"]
[340.7216, "o", " shell... let me"]
