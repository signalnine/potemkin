[519.7124, "o", "\r\r\n"]
[522.0082, "o", "\r\r\n\u001b[2m  compile sleep_ms.c\r\r\n\u001b[0m"]
[522.0833, "o", "\u001b[2m    exit=0 sha256:80cfd116e07cb526c0f28f5097381425e43ffa5dd2812c161335224750276b36\r\r\n\u001b[0m\u001b[2m  compile probe2.c\r\r\n\u001b[0m"]
[522.1576, "o", "\u001b[2m    exit=0 sha256:5f27a9cba9c8b2697148a5f3cc43080f2432843fa0ad08a26709a3c6e0681e30\r\r\n\u001b[0m"]
[526.7158, "o", "\u001b[2mNext, I'll run a probe"]
[526.7351, "o", "2 sweep with"]
[526.7543, "o", " different busy"]
[526.7735, "o", " times: 0, "]
