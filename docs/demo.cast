[804.2025, "o", "world\\n\" for"]
[804.223, "o", " it?) \u2014"]
[804.2435, "o", " let me type"]
[804.264, "o", " \"world\\n\""]
[804.2846, "o", " during the pipeline:"]
[804.3051, "o", " if the"]
