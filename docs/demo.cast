[800.8774, "o", " child"]
[800.8977, "o", " print its own"]
[800.9181, "o", " identity before"]
[800.9387, "o", " reading fd 0?"]
[800.9593, "o", " My whocares"]
[800.9799, "o", ": print identity, then read"]
[801.0004, "o", " one line from"]
[801.0209, "o", " stdin and print it, then"]
[801.0414, "o", " exit. If"]
[801.0619, "o", " it's a"]
[801.0823, "o", " proxy, the"]
[801.1028, "o", " printed"]
[801.1231, "o", " /proc/self/exe will show"]
[801.1232, "o", " the"]
[801.1437, "o", " proxy's path.\r\r\n- Phase"]
[801.1642, "o", " C:"]
[801.1847, "o", " after the"]
[801.2052, "o", " pipeline,"]
[801.2256, "o", " `pwd` \u2192"]
[801.2461, "o", " is the shell"]
[801.2666, "o", " alive?\r\r\n\r\r\n"]
[801.2871, "o", "whocares.c:\r\r\n```c"]
[801.3077, "o", "\r\r\n#include <stdio.h>\r\r\n#include"]
[801.3283, "o", " <unistd.h>\r\r\n"]
[801.3488, "o", "int main"]
[801.3694, "o", "(int argc, char **argv"]
[801.39, "o", ") {\r\r\n    char buf["]
[801.4105, "o", "256];\r\r\n   "]
[801.431, "o", " ssize_t n = readlink(\"/"]
[801.4516, "o", "proc/self/exe\", buf,"]
