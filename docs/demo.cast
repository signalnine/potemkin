[910.5762, "o", " a stage's fd 0 is"]
[910.5972, "o", " the session"]
[910.6182, "o", " TTY,"]
[910.6391, "o", " it closes it ("]
[910.6601, "o", "to prevent the"]
[910.681, "o", " stage from stealing"]
[910.7019, "o", " input), and"]
[910.7229, "o", " installs"]
[910.7437, "o", " its own"]
[910.7646, "o", " pipe"]
[910.7853, "o", " there"]
[910.8062, "o", "."]
