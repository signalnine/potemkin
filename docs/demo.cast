[240.6224, "o", " in"]
[240.6403, "o", " the"]
[240.6583, "o", " parent"]
[240.6761, "o", " after the pipeline"]
[240.6942, "o", "..."]
[240.7121, "o", " fork"]
[240.73, "o", " always works"]
[240.748, "o", ".\r\r\n\r\r\n"]
[240.766, "o", "What if the"]
[240.7841, "o", " pwd child"]
[240.8021, "o", "'s"]
[240.8201, "o", " write to fd"]
[240.8381, "o", " 1 was"]
