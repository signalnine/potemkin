[219.2553, "o", " while ("]
[219.2733, "o", "0);\r\r\n  ...\r\r\n"]
[219.2913, "o", "}\r\r\n```\r\r\n\r\r\n"]
[219.3092, "o", "I don't remember exactly. The"]
