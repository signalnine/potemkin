[516.3686, "o", "50, 100,"]
[516.3879, "o", " 200, 50"]
[516.4072, "o", "0"]
[516.4262, "o", ".\r\r\n\r\r\n"]
[516.4455, "o", "Interpretation:\r\r\n-"]
