[38.6726, "o", ":"]
[38.6901, "o", " a read returns"]
[38.7077, "o", " up to the newline."]
[38.7252, "o", " So reading"]
[38.7428, "o", " one byte at a time"]
[38.7605, "o", " in canonical mode"]
[38.7781, "o", ":"]
[38.7956, "o", " the first read returns the whole line"]
[38.8132, "o", " ("]
[38.8307, "o", "up to"]
[38.8483, "o", " "]
[38.8657, "o", "4096 bytes, the"]
[38.8834, "o", " canonical"]
[38.901, "o", " max),"]
[38.9186, "o", " subsequent reads"]
[38.9362, "o", " block"]
[38.9537, "o", "."]
[38.9712, "o", " That breaks the"]
[38.9888, "o", " one-byte"]
[39.0064, "o", "-at-a-time loop!\r\r\n\r\r\n"]
[39.0241, "o", "So I need to either: ("]
