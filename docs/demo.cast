[72.8632, "o", " old partial line \u2014 the"]
[72.8804, "o", " display shows the prompt"]
[72.8977, "o", " followed by"]
[72.9148, "o", " the old"]
[72.932, "o", " text."]
[72.9492, "o", " The user can"]
[72.9664, "o", " hit Enter to"]
[72.9836, "o", " execute"]
[73.0006, "o", " the old line."]
[73.0179, "o", " That's"]
[73.035, "o", " fine.\r\r\n\r\r\n"]
[73.0522, "o", "print_help:\r\r\n\r\r\n```c\r\r\nstatic"]
[73.0695, "o", " void print_help(void)\r\r\n{\r\r\n"]
[73.0868, "o", "    printf(\""]
[73.104, "o", "PotemkinOS shell\\n\");\r\r\n"]
[73.1213, "o", "    printf(\""]
[73.1385, "o", "Builtins"]
[73.1557, "o", ":  help  echo"]
[73.1729, "o", " [words]  cd"]
[73.1903, "o", " [dir]  pwd "]
[73.2075, "o", " exit ["]
[73.2247, "o", "code]\\n\");\r\r\n    printf(\""]
[73.242, "o", "Commands: "]
[73.2592, "o", " ls ["]
[73.2765, "o", "dir],"]
[73.2937, "o", " or anything in /generated/bin"]
[73.3109, "o", ", /bin, /usr/bin"]
[73.3282, "o", ",\\n"]
[73.3454, "o", "\"\r\r\n          "]
[73.3626, "o", " \""]
