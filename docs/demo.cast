[238.7318, "o", ","]
[238.7496, "o", " exits"]
[238.7675, "o", " 0. head"]
[238.7856, "o", " reads the first line, exits"]
[238.8037, "o", ". There"]
[238.8217, "o", "'s no SIGPIPE"]
[238.8398, "o", " here. Both"]
[238.8578, "o", " exit cleanly.\r\r\n\r\r\n"]
[238.8758, "o", "So"]
[238.8937, "o", " after the pipeline"]
[238.9118, "o", ": no pipe"]
[238.9298, "o", " fds"]
[238.9477, "o", " left"]
[238.9656, "o", " open in the parent"]
[238.9837, "o", "...\r\r\n\r\r\n"]
[239.0017, "o", "Unless"]
