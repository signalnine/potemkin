[61.6264, "o", " >"]
[61.644, "o", " f`,"]
[61.6618, "o", " my"]
[61.6793, "o", " parser"]
[61.6969, "o", " passes a redirect"]
[61.7147, "o", ";"]
[61.7322, "o", " parent-run"]
[61.7499, "o", " builtins"]
[61.7671, "o", " ignore"]
[61.7847, "o", " it \u2192"]
[61.8025, "o", " confusing."]
[61.8202, "o", " For"]
