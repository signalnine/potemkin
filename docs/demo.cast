[804.3666, "o", " (the"]
[804.3871, "o", " bridged"]
[804.4076, "o", " pty), wh"]
[804.4281, "o", "ocares gets \"world"]
[804.4486, "o", "\", prints"]
[804.469, "o", " line"]
[804.4894, "o", " 2,"]
[804.5099, "o", " and exits"]
[804.5303, "o", " \u2192 closes the pipe write"]
[804.5508, "o", " end \u2192 head"]
[804.5713, "o", " gets EOF \u2192 head"]
[804.5918, "o", " exits \u2192 the"]
[804.6124, "o", " pipeline completes \u2192 the"]
[804.633, "o", " prompt returns! If the"]
[804.6535, "o", " supervisor"]
[804.6738, "o", " doesn't bridge p"]
[804.6944, "o", "ty\u2192child"]
[804.7148, "o", " stdin (or"]
[804.7353, "o", " the proxy breaks"]
[804.7558, "o", " it), whocares blocks forever \u2192"]
[804.7763, "o", " the pipeline"]
[804.7968, "o", " hangs \u2192 `pwd"]
[804.8173, "o", "` after"]
[804.8378, "o", " it"]
[804.8583, "o", " fails"]
[804.8787, "o", ".\r\r\n5. `pwd`"]
[804.8993, "o", " \u2192"]
[804.9197, "o", " alive?\r\r\n6. `"]
[804.9404, "o", "exit"]
[804.9609, "o", "`.\r\r\n\r\r\nThis"]
[804.9813, "o", " single test"]
[805.0018, "o", " distinguishes:\r\r\n- Is the exec"]
[805.0224, "o", "'d binary"]
[805.0428, "o", " the real one ("]
[805.0633, "o", "whocares's exe path"]
[805.0839, "o", ")?\r\r\n-"]
