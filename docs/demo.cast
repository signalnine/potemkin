[484.2938, "o", "\r\r\n\r\r\n**"]
[484.3129, "o", "The harness"]
[484.3321, "o", " feeds"]
[484.3511, "o", " line N+1"]
[484.3703, "o", " when"]
[484.3893, "o", " (a)"]
