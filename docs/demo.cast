[803.5411, "o", " and exits"]
[803.5617, "o", " \u2192 the shell"]
[803.5823, "o", "'s prompt"]
[803.6029, "o", " returns.\r\r\n4. `whoc"]
[803.6235, "o", "ares | head -1` \u2014"]
[803.644, "o", " the pipeline"]
[803.6644, "o", ": whocares"]
[803.685, "o", " (stage 0)"]
[803.7054, "o", " prints"]
[803.7258, "o", " the identity, then"]
[803.7463, "o", " blocks on read(fd 0);"]
[803.7669, "o", " head (stage 1) reads"]
[803.7874, "o", " the pipe \u2192"]
[803.8079, "o", " gets"]
[803.8282, "o", " the identity line \u2192 outputs it"]
[803.8488, "o", " ("]
[803.8691, "o", "head -1) \u2192"]
[803.8896, "o", " then"]
[803.9099, "o", " blocks"]
[803.9303, "o", " waiting for more. whocares never"]
[803.9571, "o", " gets a"]
[803.9774, "o", " line ("]
[803.9979, "o", "in the"]
[804.0184, "o", " pipeline,"]
[804.0389, "o", " fd 0 ="]
[804.0595, "o", " pty;"]
[804.0799, "o", " I"]
[804.1003, "o", " don't type"]
[804.1208, "o", " for it\u2026"]
[804.1413, "o", " or"]
[804.1617, "o", " should I type"]
