[236.0127, "o", " \"/\". Works"]
[236.0308, "o", "!\r\r\n- Test 3: `"]
[236.0489, "o", "cat | head -1"]
[236.067, "o", "; pwd` \u2192 pwd"]
[236.0851, "o", "'s output is missing!"]
[236.1031, "o", "\r\r\n\r\r\nSo the"]
[236.1212, "o", " problem is"]
[236.1392, "o", " specific to"]
[236.1573, "o", " running"]
[236.1752, "o", " pwd"]
[236.193, "o", " (or any"]
[236.2111, "o", " command"]
[236.2289, "o", "?) after a"]
[236.229, "o", " pipeline"]
[236.247, "o", " within the same"]
[236.265, "o", " session."]
[236.283, "o", " After the pipeline,"]
[236.3011, "o", " the"]
[236.319, "o", " next command's"]
[236.337, "o", " child process"]
[236.355, "o", " output is lost"]
[236.373, "o", "?!\r\r\n\r\r\nWait"]
[236.3911, "o", " \u2014 but in"]
[236.4091, "o", " the big test"]
[236.4272, "o", ","]
[236.445, "o", " the commands"]
[236.463, "o", " after the pipeline"]
[236.4811, "o", " were"]
[236.4989, "o", " cd, pwd, cd,"]
[236.5171, "o", " pwd, rm, exit. cd"]
[236.5352, "o", " is silent"]
[236.5532, "o", ". pwd"]
[236.5712, "o", " lost its output. rm"]
[236.5892, "o", " is silent."]
[236.6073, "o", " So"]
[236.6251, "o", " it's consistent with"]
[236.6431, "o", " \""]
[236.661, "o", "child process output after a pipeline"]
[236.6791, "o", " is lost.\"\r\r\n\r\r\n"]
[236.6971, "o", "Hmm,"]
[236.7152, "o", " what"]
[236.7331, "o", " state"]
[236.751, "o", " does"]
[236.7689, "o", " run_pipeline leave"]
[236.7869, "o", " behind"]
[236.8048, "o", " that would"]
[236.8228, "o", " break"]
[236.8407, "o", " the"]
