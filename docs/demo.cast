[348.3313, "o", " \u2014"]
[348.3497, "o", " and the"]
[348.3682, "o", " \"wait"]
[348.3867, "o", " for output\" has"]
[348.4053, "o", " a timeout, and"]
[348.4238, "o", " that timeout"]
[348.4424, "o", " expired"]
[348.4608, "o", " before"]
[348.4791, "o", " head's output"]
[348.4977, "o", " arrived?"]
