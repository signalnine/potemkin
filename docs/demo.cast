[38.1819, "o", " (errno == EINTR) continue;"]
[38.1995, "o", "\r\r\n            return -1;\r\r\n       "]
[38.2173, "o", " }\r\r\n        if (c"]
[38.235, "o", "=='\\n' || len"]
[38.2526, "o", "+1 >= size) { buf[len"]
[38.2703, "o", "]=0; return"]
[38.2879, "o", " 0; }\r\r\n        buf[len"]
[38.3056, "o", "++]=c;\r\r\n    }\r\r\n}"]
[38.3232, "o", "\r\r\n```\r\r\n\r\r\nRead"]
[38.3408, "o", " one"]
[38.3582, "o", " byte at a time \u2014 fine for"]
[38.3758, "o", " a"]
[38.3933, "o", " text"]
[38.4107, "o", " console ("]
[38.4283, "o", "echo"]
[38.4457, "o", " is done by the tty"]
[38.4633, "o", " driver in"]
[38.4803, "o", " canonical mode"]
[38.4978, "o", "\u2026 wait, if the"]
[38.5148, "o", " tty is in canonical mode, read("]
[38.5325, "o", "0"]
[38.55, "o", ",&c,1) returns a"]
[38.5676, "o", " whole line"]
[38.5851, "o", " at once!"]
[38.6027, "o", " Because"]
